              "margin-bottom": "20px",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              }
            },
            ".list": {
              "width": "100%",
              "list-style": "none",
              "padding-left": "0",
              "margin-bottom": "40px",
              "color": "#C4CFDE",
              "transition": "0.4s all",
              "@media (max-width: 575px)": {
