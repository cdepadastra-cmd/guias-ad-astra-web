              "background-color": "@card",
              "height": "100%",
              "border-radius": "30px",
              "img": {
                "max-width": "280px",
                "height": "400px",
                "object-fit": "cover",
                "border-radius": "20px",
                "@media (max-width: 768px)": {
                  "height": "300px"
                }
              }
            },
            ".title-wrapper": {
              "padding-left": "100px",
              "& when (@reverseContent)": {
                "padding-left": "0",
