          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".menu-item": {
              "padding": "0",
              "display": "flex",
              "margin-bottom": "1.5rem"
            },
            ".item-tag": {
              "background": "@iconColor",
              "width": "fit-content",
              "padding": "3px 16px 0px 16px",
              "border-radius": "10px",
              "margin-bottom": "12px"
            },
            ".mbr-iconfont": {
              "font-size": "2.5rem",
              "padding-right": "1rem",
              "color": "@iconColor"
            },
            ".mbr-figure": {
              "width": "150px",
              "height": "100%",
              "img": {
                "border-radius": "6px",
                "object-fit": "cover",
                "margin-right": "2rem",
                "width": "110px",
                "height": "110px"
              }
            },
            ".inline-wrap": {
              "width": "fit-content",
              "display": "inline-block"
            },
            ".group-title": {
              "margin": "0",
              "color": "#181818",
              "font-weight": "bold",
              "text-align": "left"
            },
            "@media (max-width: 991px)": {
              ".mbr-figure": {
                "width": "fit-content !important"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-figure": {
                "width": "100% !important"
              },
              ".menu-item": {
                "flex-direction": "column"
              },
              "img": {
                "margin": "auto !important",
                "margin-bottom": "0.5rem !important"
              },
              ".item-tag": {
                "margin": "auto",
                "margin-bottom": "1rem"
              }
            },
            ".icon-wrap": {
              "display": "flex",
              "margin-bottom": "1.5rem",
              "align-items": "center",
              "width": "fit-content"
            },
            ".special-label": {
              "color": "#fff"
            },
            ".menu-box": {
              "display": "flex",
              "align-items": "baseline",
              "margin-bottom": "0.5rem",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between",
              ".box-price": {
                "-webkit-flex-shrink": "0",
                "flex-shrink": "0"
              }
            },
            ".menu-row": {
              "margin": "0"
            },
            ".box-text": {
              "padding": "0",
              "margin": "0",
              "width": "fit-content",
              "color": "#000000"
            },
            ".line": {
              "display": "flex",
              "flex": "1 1 auto",
              "background-image": "radial-gradient(circle closest-side, #9a9a9a 99%, rgba(255, 255, 255, 0) 1%)",
              "background-size": "12px 2px",
              "background-position": "center",
              "margin": "0.2em 0.5em",
              "background-repeat": "repeat",
              "height": "2px"
            },
            ".group-title, .align-wrap": {
              "text-align": "left"
            },
            "SPAN": {
              "color": "#e7272d"
            },
            ".item-title": {
              "color": "#808080"
            },
            "H4": {
              "color": "#e7272d"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_cid": "tyGSuumF89",
          "_anchor": "content04-4a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content03",
          "_sourceTheme": "laborm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article3\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showsubTitle\" title=\"Subtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/laborm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/laborm5/components/_images/background1.jpg\" name=\"fallBackImage\"\n            condition=\"bg.type === 'video'\">\n        condition=\"overlay && bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\"\n        video-to-image-on-mobile=\"{{videoToImageOnMobile}}\">\n        <div class=\"row\">\n\n            <div class=\"col-sm-12 mb-5 col-md-12 col-lg-5\">\n                <div class=\"content\">\n                    <h3 class=\"mbr-main-subtitle  mb-4  mbr-fonts-style align-left\" mbr-if=\"showsubTitle\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-main-subtitle\"><b>Services</b></h3>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-1\"\n                        mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>QUALITY\n                        </b>\n                        <div><b>PRIORITY</b></div>\n                    </h4>\n                    <div class=\"text-wrapper\">\n\n                        <p class=\"card1-text pb-3 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                            data-app-selector=\".card1-text, .mbr-section-btn\">Praesent ut libero dignissim, suscipit\n                            justo in, faucibus ante. Suspendisse in accumsan nisl. Mauris vulputate congue euismod.\n                            Nullam eget cursus magna. Phasellus quam magna, consequat sed hendrerit et, pharetra\n                            eleifend ante. Duis nec ligula urna. Maecenas ligula massa, fermentum sit amet maximus eget,\n                            iaculis nec felis.&nbsp;</p>\n                        <div class=\"mbr-section-btn card-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\"\n                            mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-white\"\n                                href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                    </div>\n\n\n                </div>\n            </div>\n\n            <div class=\"col-sm-12 col-md-12 col-lg-6\">\n                <div class=\"card-wrap\">\n                    <h3 class=\"mbr-main-subtitle mb-3 mbr-fonts-style align-left\" mbr-if=\"showsubTitle\"\n                        mbr-theme-style=\"display-4\" data-app-selector=\".mbr-main-subtitle\"><b>Projects</b></h3>\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left pb-2\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                        <b>Construction</b>\n                    </h5>\n\n                    <p class=\"card-text mbr-fonts-style pb-3 align-left\"\n                        data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-4\"\n                        mbr-if=\"showCardText\">\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut eget dictum velit nisi.&nbsp;Nullam\n                        bibendum elit vitae fermentum dapibus. Morbi molestie mi at enim porttitor, non ultrices elit\n                        dignissim. Nulla sem justo, faucibus sed elit quis.</p>\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/features6.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n\n                </div>\n            </div>\n\n\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "@media (min-width: 1400px)": {
              ".container": {
                "max-width": "1200px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".text-wrapper": {
              "border-left": "4px solid @primaryColor",
              "padding-left": "2rem"
            },
            ".mbr-main-subtitle": {
              "background": "@primaryColor",
              "width": "fit-content",
              "padding": "0.6rem 1rem",
              "position": "relative",
              "&:before": {
                "content": "''",
                "position": "absolute",
                "left": "0",
                "bottom": "-18px",
                "border-left": "24px solid @primaryColor",
                "border-bottom": "18px solid transparent",
                "z-index": "2"
              },
              "@media (max-width: 767px)": {
                "margin": "auto",
                "margin-bottom": "2rem"
              },
              "color": "#000000"
            },
            ".image-wrap": {
              "overflow": "hidden"
            },
            ".card-wrap": {
              ".mbr-main-subtitle": {
                "&:before": {
                  "content": "none"
                }
              },
              "&:hover": {
                "img": {
                  "transform": "scale(1.05)"
                }
              },
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              ".image-wrap img": {
                "width": "100%",
                "transition": "all 0.3s",
                "object-fit": "cover"
              }
            },
            ".card-text, .mbr-section-btn, .social-row": {
              "color": "#353535"
            },
            ".card1-text": {
              "color": "#353535"
            },
            ".card-title, .social-row": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000"
            }
          },
          "_cid": "tyGSuvUUTn",
          "_anchor": "content03-4b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
