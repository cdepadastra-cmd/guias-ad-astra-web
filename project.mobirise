          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content6 cleanm4_content6\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"7\" condition=\"!fullScreen\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n\t\t<select title=\"Cards 1\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\" selected>1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<select title=\"Items Count\" name=\"widgetItemsCount\" condition=\"showWidget\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\" selected>6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t</select>\n\t\t<select title=\"Cards 2\" name=\"cardsAmount2\" condition=\"showBottomPart\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\" selected>2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Widget\" name=\"showWidget\" checked>\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n\t\t<input type=\"color\" title=\"Input BG Color\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"color\" title=\"Input Text Color\" name=\"inputTextColor\" value=\"#83868c\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n\t\t<input type=\"checkbox\" title=\"Text 1\" name=\"showTabText1\" checked>\n\t\t<input type=\"checkbox\" title=\"Text 2\" name=\"showTabText2\">\n\t\t<input type=\"checkbox\" title=\"Bottom Part\" name=\"showBottomPart\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\n\t\t<input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n\t\t<input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"swIcon\" checked>\n\t\t<input type=\"color\" title=\"Icon Bg\" name=\"iconBgColor\" value=\"#19a6fa\" selected>\n\t\t<header condition=\"showWidget\">Widget</header>\n\t\t<input type=\"color\" title=\"Bg Color\" name=\"widgetBgColor\" value=\"#eeeff2\" selected condition=\"showWidget\">\n\t\t<input type=\"color\" title=\"Border Color\" name=\"widgetBorderColor\" value=\"#dcdfe2\" selected condition=\"showWidget\">\n\t\t<header condition=\"showBottomPart\">Bottom Part</header>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"swIcon2\" checked condition=\"showBottomPart\">\n\t\t<input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle2\" checked condition=\"showBottomPart\">\n\t\t<input type=\"checkbox\" title=\"Card Text\" name=\"showCardText2\" checked condition=\"showBottomPart\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/cleanm4/components/_images/background2.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n\t\t<div class=\"row main-row\">\n\t\t\t<div class=\"col-md-4\">\n\t\t\t\t<div class=\"widget-container\" mbr-if=\"showWidget\">\n\t\t\t\t\t<div class=\"project-info\">\n\t\t\t\t\t\t<div class=\"info-item\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tÉPOCA:\n\t\t\t\t\t\t\t</b></p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">del 5 al 11 de agosto de 2025.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 1\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tDURACIÓN</b>:\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">6 días y 5 noches.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 2\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>PRECIOS POR PERSONA:</b></p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">743€</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 3\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>GRUPO MÁXIMO:</b>&nbsp;20 personas.&nbsp;</p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 4\">\n\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>GRUPO MÍNIMO:</b>&nbsp;5 personas</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"newsletter\" mbr-if=\"showForm\">\n\t\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".newsletter .mbr-section-subtitle\">\n\t\t\t\t\t\tConsulta nuestras fechas disponibles</h3>\n\t\t\t\t\t<div mbr-form class=\"form1\" mbr-if=\"showForm\">\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t\t<form action=\"guiasadastra@gmail.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler px-2\" data-verified=\"guiasadastra@gmail.com\">\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">¡Gracias por tu mensaje!</div>\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"dragArea row\">\n\t\t\t\t\t\t\t\t<div class=\"col-lg-12 form-group\" data-for=\"name\">\n\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"first-name\" placeholder=\"Tu nombre\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"form-group col\" data-for=\"email\">\n\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"email\" placeholder=\"Tu email\" data-form-field=\"E-mail\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\">\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div data-for=\"message\" class=\"col-lg-12 form-group\">\n\t\t\t\t\t\t\t\t\t<textarea name=\"message\" placeholder=\"Escribe tu consulta\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\" value></textarea>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-lg btn-secondary\" data-app-placeholder=\"Type Text\">Enviar mensaje</a></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</form>\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-md-8\">\n\t\t\t\t<h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\tDetails\n\t\t\t\t</h3>\n\t\t\t\t<h2 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">TREKKING DE CARROS DE FOC</h2>\n\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/background3.jpg\" mbr-if=\"showImage\" class=\"mb-5 mt-3\" alt>\n\n\n\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText1\" data-app-selector=\".mbr-text\">El treck general discurre en su totalidad por un terreno de alta montaña formado por bloques de\n<br>granito, pedreras y caminos en fuerte pendiente.\n<br>El itinerario no dispone de un marcaje especial. En algunos tramos el itinerario comparte camino\n<br>con el GR 11 donde encontraremos marcas de pintura roja y blanca. Otros tramos están\n<br>marcados con estacas de madera pintadas de amarillo y la mayor parte del tiempo\n<br>seguiremos el camino gracias a los hitos (montoncitos de piedras) que otros montañeros\n<br>construyeron antes que nosotros. El uso del mapa es imprescindible.<br>\n<br>Después de una actividad de aproximación al refugio de Colomina comenzaremos una travesía\n<br>circular que en 6 etapas recorrerá parte del Parque Nacional y que recibe el nombre comercial\n<br>de CARROS DE FUEGO o Ruta de los 9 refugios.<br>\n<br>Carros de Foc (en castellano Carros de Fuego) es una ruta de montaña de 65 km y 5.700 m de\n<br>desnivel positivo que consiste en visitar los nueve refugios que hay dentro del Parque nacional\n<br>de Aiguas Tortas y Lago de San Mauricio, entre las comarcas del Pallars Sobirá, el Valle de Arán,\n<br>la Alta Ribagorza y el Pallars Jussá.<br>\n<br>Los refugios se encuentran entre los 1.900 y los 2.400 m de altitud. La altura media de la travesía\n<br>es de 2.400 m y el punto más elevado es el collet de Contraix, de 2.748 m, entre los valles de\n<br>Colieto y de Contraix, entre los refugios de Estany Llong y Joan Ventosa i Calvell.<br><br><b>REQUISITOS</b><br><br>- Ropa de montaña adecuada según estación.\n<br>- Es necesaria una condición física aceptable y estar habituado a caminar por montaña en terreno rocoso jornadas de 8-9 horas.\n<br>- No tener vértigo, estar habituado a pequeñas trepadas\n<br>- Respetar el trabajo de guía, profesional que siempre vela por llegar a buen puerto y por la seguridad del grupo.<br><br><br><b>MATERIAL NECESARIO</b><br>\n\t\t\t\t</p>\n\t\t\t\t<div class=\"cards-wrap d-flex mt-4\">\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-snowcapped-mountains\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Nudos básicos para autorrescate.</h4>\n\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">- Mochila cómoda de 35 litros aprox. (Muy recomendable un peso total de 8 kg máximo)\n<br>- Pantalones largos para caminar\n<br>- Calzado de montaña cómodo (Botas)\n<br>- Camiseta de manga larga\n<br>- Ropa de abrigo. Tipo forro polar / Primaloft\n<br>- Impermeable tipo Gore Tex\n<br>- Recomendable unos pantalones impermeables\n<br>- 1 muda completa\n<br>- Sombrero o gorra\n<br>- Gorro y guantes\n<br>- Cantimplora\n<br>- Protector solar\n<br>- Gafas de sol\n<br>- Linterna frontal\n<br>- Saco ligero\n<br>- Neceser elemental\n<br>- Bastones para caminar\n<br>- Bañador</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-mountain\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Métodos de fortuna y con material para ascenso y descenso de cuerda en distintas situaciones.</h4>\n\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">El mejor mirador del Circo de Gredos, con vistas a los picos más altos del Sistema Central y a la Laguna Grande desde las alturas, además de completar las vistas hacia Cáceres y Toledo.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-snowcapped-mountains\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Rapel precario y posibles problemas.</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Un circo glaciar de doble lengua alberga las espectaculares Cinco Lagunas, en una preciosa ruta en la que se pasará por otra laguna y una zona de pequeñas cascadas escalonadas.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-mountain\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\">Pasos de nudo durante el ascenso y descenso.</h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">En esta ruta podremos ver Los Galayos, una serie de agujas de roca que se levantan verticales y hacen del lugar un paraíso para la escalada.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular mb-5\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText2\" data-app-selector=\".mbr-text\"><b>DESCRIPCIÓN\n</b><br>Actividad de desplazamiento en espacios naturales, realizada caminando, cuyo objetivo es el recorrido de senderos y caminos señalizados o no.<br><br><br></p>\n\t\t\t\t<div class=\"row bottomPart\" mbr-if=\"showBottomPart\">\n\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t<div class=\"image-wrap mb-5\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/mbr-692x1017.jpg\" alt>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t<div class=\"cards-wrap2 d-flex\">\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 0\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-add-shopping-cart\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">INCLUYE</h4>\n\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">- Vuelos hasta Tesalónica (Posibilidad de gestionarlos)\n<br>- 2 Guías de Montaña titulados. UIMLA / AEGM\n<br>- Asesoramiento técnico previo a la actividad\n<br>- 4 noches en los refugios de la ruta en Media Pensión (Refugio Spilios Agapitos, Refugio Petrostrouga)\n<br>- 1 noches en Alojamiento y desayuno en Litokoro,\n<br>- 1 noche en Alojamiento y desayuno en Tesalónica.\n<br>- Transfer privado aeropuerto de Tesalónica - Litokoro\n<br>- Transfer privado Dhion - Tesalónica\n<br>- Transporte Tesalónica - aeropuerto\n<br>- Seguro de asistencia\n<br>- Material técnico para la ascensión (casco, arneses y cuerda auxiliar)\n<br>- Botiquín colectivo</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 1\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-clear-cart\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">NO INCLUYE:\n\t\t\t\t\t\t\t\t\t</h4>\n\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">- Bebidas en las comidas\n<br>- Comidas durante todo el recorrido\n<br>- Cena en Tesalónica\n<br>- Entradas a museos, extras en los refugios</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 2\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-remouve-cart2\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">NO INCLUYE:</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Desplazamientos, comidas y todo lo no indicado en el apartado anterior.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 3\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Cleaning is...\n\t\t\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n\t\t\t\t\t\t\t\t\t\tamet, consecte tempor incididunt ut\n\t\t\t\t\t\t\t\t\t\tlabore\n\t\t\t\t\t\t\t\t\t\tet\n\t\t\t\t\t\t\t\t\t\tdolore tumber tur adipisicing elit.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t<a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n\t\t\t\t\t\tLearn More</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
