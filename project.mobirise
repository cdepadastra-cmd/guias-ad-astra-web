              "transition": "all 0.3s",
              "&:hover": {
                "box-shadow": "0 20px 30px rgba(0, 0, 0, 0.1)",
                "margin-top": "-0.6rem"
              },
              "&:hover .price-box": {
                "-webkit-transform": "scale(1.2)",
                "transform": "scale(1.2)",
