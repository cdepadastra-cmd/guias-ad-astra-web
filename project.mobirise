-placeholder=\"Type Text\">Palencia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Salamanca</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Valladolid</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item text-white text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Grandes travesías</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"trekking-carros-de-foc.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Carros de Foc (Pirineos)</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Rutas invernales</a></div></li>\n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">VIAJES</a><div class=\"dropdown-menu\"><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Alpes</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Tour del Mont Blanc</a><a class=\"mbr-