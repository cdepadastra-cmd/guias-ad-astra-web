        {
          "_name": "content6",
          "_sourceTheme": "cleanm4",
          "_customHTML": "<section class=\"content6 cleanm4_content6\" group=\"Content\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"7\" condition=\"!fullScreen\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"!fullScreen\">\n\t\t<select title=\"Cards 1\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t</select>\n\t\t<select title=\"Items Count\" name=\"widgetItemsCount\" condition=\"showWidget\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\" selected>6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t</select>\n\t\t<select title=\"Cards 2\" name=\"cardsAmount2\" condition=\"showBottomPart\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Widget\" name=\"showWidget\" checked>\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\">\n\t\t<input type=\"color\" title=\"Input BG Color\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"color\" title=\"Input Text Color\" name=\"inputTextColor\" value=\"#83868c\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTabTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n\t\t<input type=\"checkbox\" title=\"Text 1\" name=\"showTabText1\" checked>\n\t\t<input type=\"checkbox\" title=\"Text 2\" name=\"showTabText2\">\n\t\t<input type=\"checkbox\" title=\"Bottom Part\" name=\"showBottomPart\" checked>\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n\n\t\t<input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"swIcon\" checked>\n\t\t<input type=\"color\" title=\"Icon Bg\" name=\"iconBgColor\" value=\"#19a6fa\" selected>\n\t\t<header condition=\"showWidget\">Widget</header>\n\t\t<input type=\"color\" title=\"Bg Color\" name=\"widgetBgColor\" value=\"#eeeff2\" selected condition=\"showWidget\">\n\t\t<input type=\"color\" title=\"Border Color\" name=\"widgetBorderColor\" value=\"#dcdfe2\" selected condition=\"showWidget\">\n\t\t<header condition=\"showBottomPart\">Bottom Part</header>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"swIcon2\" checked condition=\"showBottomPart\">\n\t\t<input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle2\" checked condition=\"showBottomPart\">\n\t\t<input type=\"checkbox\" title=\"Card Text\" name=\"showCardText2\" checked condition=\"showBottomPart\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/cleanm4/components/_images/background2.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n\t\t<div class=\"row main-row\">\n\t\t\t<div class=\"col-md-4\">\n\t\t\t\t<div class=\"widget-container\" mbr-if=\"showWidget\">\n\t\t\t\t\t<div class=\"project-info\">\n\t\t\t\t\t\t<div class=\"info-item\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tÉPOCA:\n\t\t\t\t\t\t\t</b></p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">Primavera, verano y otoño.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 1\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tDURACIÓN</b>:\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">4-5 horas</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 2\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tDIFICULTAD</b>: NIVEL II<br><br>Leyenda:</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">- <b>Nivel I:</b> Nivel de iniciación, perfecto para personas que nunca han realizado barranquismo o lo han hecho pero no quieren rapeles muy grandes ni complicaciones.<br>- <b>Nivel II:</b> Para personas que les guste el barranquismo sin importar que haya saltos, toboganes o rápeles largos.<br>- <b>Nivel III: </b>Para personas con práctica en barrancos con grandes verticales y posible buen caudal de agua.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 3\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>PRECIOS POR PERSONA</b>:</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">35€.<br></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 4\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tEDAD MÍNIMA</b>:\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">12 años*</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 5\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\"><b>\n\t\t\t\t\t\t\t\tNº MÍNIMO DE PARTICIPANTES:\n\t\t\t\t\t\t\t</b></p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">6</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"info-item\" mbr-if=\"widgetItemsCount > 6\">\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text label\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .label\">\n\t\t\t\t\t\t\t\tOther Info:\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular info-text\" mbr-theme-style=\"display-4\" data-app-selector=\".widget-container .project-info .info-item .info-text\">\n\t\t\t\t\t\t\t\tAnything\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"newsletter\" mbr-if=\"showForm\">\n\t\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".newsletter .mbr-section-subtitle\">\n\t\t\t\t\t\tHave Any Query?\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div mbr-form class=\"form1\" mbr-if=\"showForm\">\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t\t<form action name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler px-2\">\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for\n\t\t\t\t\t\t\t\t\tfilling\n\t\t\t\t\t\t\t\t\tout the form!</div>\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"dragArea row\">\n\t\t\t\t\t\t\t\t<div class=\"col-lg-12 form-group\" data-for=\"name\">\n\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"first-name\" placeholder=\"Your Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"form-group col\" data-for=\"email\">\n\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"email\" placeholder=\"Email Address\" data-form-field=\"E-mail\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\">\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div data-for=\"message\" class=\"col-lg-12 form-group\">\n\t\t\t\t\t\t\t\t\t<textarea name=\"message\" placeholder=\"Write Query\" data-form-field=\"message\" mbr-theme-style=\"display-4\" class=\"form-control\" value></textarea>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\">\n\t\t\t\t\t\t\t\t\t<a type=\"submit\" class=\"btn btn-lg btn-success\">Send Message</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</form>\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-md-8\">\n\t\t\t\t<h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-semibold mt-lg-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\tDetails\n\t\t\t\t</h3>\n\t\t\t\t<h2 class=\"mbr-fonts-style mbr-section-title mbr-bold align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showTabTitle\" data-app-selector=\".mbr-section-title\">\n\t\t\t\t\tBARRANCO DEL ARBILLAS (GREDOS)</h2>\n\t\t\t\t<img src=\"@ADDONS_PATH@/cleanm4/components/_images/img/05.jpg\" mbr-if=\"showImage\" class=\"mb-5 mt-3\">\n\n\n\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText1\" data-app-selector=\".mbr-text\">\n\t\t\t\t\tVen a descubrir la actividad que te acerca al mundo natural de la forma más saludable. Caminaremos por montañas y valles a través de sus senderos, caminos y veredas. Te guiaremos por los rincones más atractivos del interior de la provincia de Alicante, zona especialmente indicada para el senderismo por su carácter montañoso, clima inigualable y multitud de espacios naturales protegidos. Pero no te limites a nuestra provincia, podemos guiarte por la zona que nos propongas.<br><br><br><b>DESCRIPCIÓN\n</b><br>El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n<br>Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte.\n<br>Muy cerca de Salamanca, Ávila y Madrid.<br><br><br><b>ITINERARIOS DESTACADOS</b><br>\n\t\t\t\t</p>\n\t\t\t\t<div class=\"cards-wrap d-flex mt-4\">\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 0\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-snowcapped-mountains\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\"><b>Duración</b></h4>\n\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">La duración media del barranco está en las 3 horas.<br>La aproximación es inmediata desde el parking y el retorno nos supondrá 30´ andando por buen terreno.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-mountain\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\"><b>Rápeles</b></h4>\n\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">6 rápeles siendo el más lardo de 25 metros</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-snowcapped-mountains\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\"><b>Toboganes</b></h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Podremos disfrutar de un buen tobogán a mitad de recorrido.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount > 3\">\n\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon\">\n\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-mountain\"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"content\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".cards-wrap .wrapper .content .mbr-card-title, .img\"><b>Saltos</b></h4>\n\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".cards-wrap .wrapper .content .mbr-text, .img\">Este barranco dispone de unos posibles saltos, que no son obligatorios ya que se pueden rapelar o esquivar.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"mbr-fonts-style mbr-text mbr-regular mb-5\" mbr-theme-style=\"display-4\" mbr-if=\"showTabText2\" data-app-selector=\".mbr-text\"><b>DESCRIPCIÓN\n</b><br>Actividad de desplazamiento en espacios naturales, realizada caminando, cuyo objetivo es el recorrido de senderos y caminos señalizados o no.<br><br><br></p>\n\t\t\t\t<div class=\"row bottomPart\" mbr-if=\"showBottomPart\">\n\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t<div class=\"image-wrap mb-5\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-355x400.png\" alt>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t\t\t<div class=\"cards-wrap2 d-flex\">\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 0\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-t-shirt-1\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">MATERIAL PERSONAL QUE DEBES TRAER:</h4>\n\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">- Bañador.<br>- Zapatillas para mojar.<br>- Toalla.<br>- Zapatillas y ropa de cambio.<br>- Crema solar.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 1\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-done-cat\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">INCLUYE:\n\t\t\t\t\t\t\t\t\t</h4>\n\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">-&nbsp; Guía titulado.<br>- Seguros (accidentes y responsabilidad civil), - - Impuestos incluidos en el precio.<br>- Material técnico y de seguridad necesario para realizar la actividad.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 2\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-remouve-cart2\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">NO INCLUYE:</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Desplazamientos, comidas y todo lo no indicado en el apartado anterior.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"row-item\" mbr-if=\"cardsAmount2 > 3\">\n\t\t\t\t\t\t\t\t<div class=\"wrapper2\">\n\t\t\t\t\t\t\t\t\t<div class=\"img\" mbr-if=\"swIcon2\">\n\t\t\t\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbri-contact-form\"></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style mbr-card-title mbr-semibold align-left pb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle2\" data-app-selector=\".bottomPart .wrapper2 .mbr-card-title, .img\">Cleaning is...\n\t\t\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-regular align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText2\" data-app-selector=\".bottomPart .wrapper2 .mbr-text, .img\">Lorem ipsum dolor\n\t\t\t\t\t\t\t\t\t\tamet, consecte tempor incididunt ut\n\t\t\t\t\t\t\t\t\t\tlabore\n\t\t\t\t\t\t\t\t\t\tet\n\t\t\t\t\t\t\t\t\t\tdolore tumber tur adipisicing elit.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"mbr-section-btn align-left\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t<a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n\t\t\t\t\t\tLearn More</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "@secondaryColor"
            },
            ".mbr-section-title": {
              "color": "@primaryColor"
            },
            "img": {
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              ".btn": {
                "margin-left": "0 !important"
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "left"
              }
            },
            ".cards-wrap": {
              "flex-direction": "column"
            },
            ".wrapper": {
              "border-radius": "0.25rem",
              "margin-bottom": "26px",
              "display": "flex",
              ".img": {
                "margin-bottom": "20px",
                "margin-right": "25px",
                "background-color": "@iconBgColor",
                "width": "50px",
                "min-width": "50px",
                "height": "50px",
                "border-radius": "3px",
                "display": "inline-flex",
                "align-items": "center",
                "justify-content": "center",
                "&:hover": {
                  "-webkit-animation-name": "animation-wobble-vertical",
                  "animation-name": "animation-wobble-vertical",
                  "-webkit-animation-duration": "1s",
                  "animation-duration": "1s",
                  "-webkit-animation-timing-function": "ease-in-out",
                  "animation-timing-function": "ease-in-out",
                  "-webkit-animation-iteration-count": "1",
                  "animation-iteration-count": "1"
                },
                ".mbr-iconfont": {
                  "font-size": "1.875rem",
                  "top": "0",
                  "color": "contrast(@iconBgColor)",
                  "border-radius": "50%"
                }
              },
              ".content": {
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            ".widget-container": {
              "margin": "0 0 30px",
              ".project-info": {
                "padding": "15px 30px 13px",
                "background-color": "@widgetBgColor",
                "border-radius": "3px",
                ".info-item": {
                  "display": "flex",
                  "flex-wrap": "wrap",
                  "padding": "17px 0",
                  "border-bottom": "1px solid @widgetBorderColor",
                  ".label": {
                    "font-weight": "500",
                    "margin-right": "10px",
                    "flex": "none",
                    "margin-bottom": "0"
                  },
                  ".info-text": {
                    "margin-bottom": "0"
                  },
                  "&:last-child": {
                    "border-bottom": "none"
                  }
                }
              }
            },
            ".newsletter": {
              "padding": "35px 30px 40px",
              "border-radius": "3px",
              "display": "block",
              ".mbr-section-subtitle": {
                "position": "relative",
                "margin-bottom": "25px",
                "color": "@primaryColor"
              },
              ".form-group, .mbr-section-btn": {
                "margin": "0",
                "padding": "0",
                "display": "-webkit-flex"
              },
              "textarea": {
                "height": "110px !important"
              },
              ".form-control": {
                "font-size": "14px",
                "background": "@inputBg",
                "color": "@inputTextColor",
                "display": "block",
                "height": "60px",
                "border-radius": "3px",
                "width": "100%",
                "padding": "13px 20px !important",
                "padding-right": "50px !important",
                "transition": "all .3s linear 0ms",
                "&::-webkit-input-placeholder": {
                  "color": "@inputTextColor"
                },
                "&::-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-moz-placeholder": {
                  "color": "@inputTextColor"
                },
                "&:-ms-input-placeholder": {
                  "color": "@inputTextColor"
                }
              },
              ".form-group": {
                "margin-bottom": "8.6px"
              },
              ".dragArea": {
                "flex-direction": "column",
                ".mbr-section-btn": {
                  ".btn": {
                    "font-weight": "bold",
                    "margin-left": "0 !important",
                    "margin-right": "0 !important",
                    "position": "relative",
                    "overflow": "hidden",
                    "&.btn-success": {
                      "&:hover": {
                        "background-color": "@secondaryColor !important",
                        "border-color": "@secondaryColor !important",
                        "color": "#ffffff !important"
                      }
                    },
                    "&::after": {
                      "background-color": "@infoColor",
                      "content": "\"\"",
                      "height": "150px",
                      "left": "-75px",
                      "position": "absolute",
                      "top": "-60px",
                      "transform": "rotate(35deg)",
                      "transition": "all 1.5s cubic-bezier(0.19, 1, 0.22, 1)",
                      "width": "40px",
                      "opacity": "0",
                      "outline": "none",
                      "text-decoration": "none"
                    },
                    "&:hover": {
                      "&::after": {
                        "left": "250px",
                        "opacity": "0.8"
                      }
                    }
                  }
                }
              }
            },
            ".cards-wrap2": {
              "flex-direction": "column",
              ".wrapper2": {
                "border-radius": "0.25rem",
                "margin-bottom": "26px",
                ".img": {
                  "margin-bottom": "20px",
                  ".mbr-iconfont": {
                    "font-size": "50px",
                    "top": "0",
                    "color": "@secondaryColor",
                    "border-radius": "50%"
                  }
                },
                ".mbr-card-title": {
                  "color": "@primaryColor",
                  "padding-bottom": "14px",
                  "margin-bottom": "10px"
                },
                ".mbr-text": {
                  "margin-bottom": "19px",
                  "color": "@infoColor"
                }
              }
            },
            "@-webkit-keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            "@keyframes animation-wobble-vertical": {
              "16.65%": {
                "transform": "translateY(8px)"
              },
              "33.3%": {
                "transform": "translateY(-6px)"
              },
              "49.95%": {
                "transform": "translateY(4px)"
              },
              "66.6%": {
                "transform": "translateY(-2px)"
              },
              "83.25%": {
                "transform": "translateY(1px)"
              },
              "100%": {
                "transform": "translateY(0)"
              }
            },
            ".cards-wrap .wrapper .content .mbr-text, .img": {
              "color": "#000000"
            },
            ".bottomPart .wrapper2 .mbr-text, .img": {
              "color": "#000000"
            },
            ".widget-container .project-info .info-item .info-text": {
              "text-align": "left"
            }
