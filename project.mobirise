        {
          "_name": "info1",
          "_sourceTheme": "mobirise4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(45deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".btn": {
              "margin": "0 0 .5rem 0"
            },
            "& when (@reverseContent)": {
              ".content-row": {
                "flex-direction": "row-reverse",
                "-webkit-flex-direction": "row-reverse"
              }
            },
            "H2": {
              "color": "#5b686b"
            }
          },
          "_customHTML": "<section class=\"mbr-section info1\" group=\"Info\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!--Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Text on left/right\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background8-1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#19a6fa\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Bg\" name=\"gradientBg\" condition=\"bg.type=='color'\">\n        <input type=\"color\" name=\"color2\" title=\"Color 2\" value=\"#cebfaf\" condition=\"bg.type=='color' && gradientBg\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center content-row\">\n            <div class=\"media-container-column title col-12 col-lg-7 col-md-6\">\n                <h3 mbr-if=\"showSubtitle\" class=\"mbr-section-subtitle align-left mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\"><b>¿QUIERES DISFRUTAR DE ESTA ACTIVIDAD CON NOSOTROS?</b></h3>\n                <h2 mbr-if=\"showTitle\" class=\"align-left mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"><span style=\"font-weight: normal;\">Damos servicio externo de asesoría a colegios, comedores escolares, residencias de estudiantes y geriatría, empresas, madres de día.</span></h2>\n            </div>\n            <div class=\"media-container-column col-12 col-lg-3 col-md-4\">\n                <div class=\"mbr-section-btn align-right py-4\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"contacto.html\" data-app-placeholder=\"Type Text\">MÁS INFORMACIÓN Y RESERVAS</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "tyGSul1iCN",
          "_anchor": "info1-3x",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "ul": {
              "list-style": "none",
              "margin": "0",
              "padding-left": "2.5rem"
            },
            "li": {
              "position": "relative",
              "&:nth-last-child(n+2)": {
                "margin-bottom": "1rem"
              }
            },
            "ul li::before": {
              "position": "absolute",
              "left": "-1.6rem",
              "content": "\"\\2022\"",
              "color": "@iconColor",
              "font-weight": "bold",
              "font-size": "2rem",
              "width": "1.6rem"
            },
            ".background": {
              "padding": "3rem 1rem",
              "background-color": "@titleBackground",
              "@media (min-width: 992px)": {
                "margin-top": "5rem"
              }
            },
            "@media (min-width: 992px)": {
              ".display-1": {
                "font-size": "70px"
              },
              ".display-5": {
                "font-size": "29px"
              },
              ".display-7": {
                "font-size": "22px"
              }
            }
          },
          "_name": "content4",
          "_sourceTheme": "mentorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Content\" class=\"content4\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"11\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <select title=\"Amount\" name=\"colAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#415d7d\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Title background\" name=\"titleBackground\" value=\"#eeff42\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-5\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>SENDERISMO</b></h3>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <div class=\"row justify-content-center\">\n                    <div class=\"col-12 col-lg-6 background\" mbr-if=\"colAmount > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                            <li>Ven a descubrir la actividad que te acerca al mundo natural de la forma más saludable. Caminaremos por montañas y valles a través de sus senderos, caminos y veredas. Te guiaremos por los rincones más atractivos del interior de la provincia de Alicante, zona especialmente indicada para el senderismo por su carácter montañoso, clima inigualable y multitud de espacios naturales protegidos. Pero no te limites a nuestra provincia, podemos guiarte por la zona que nos propongas.</li>\n                        </ul>\n                    </div>\n                    <div class=\"col-12 col-lg-6  mt-3 mt-lg-0\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                            <li><b>Identify your true desires</b><br>Remember what you wanted as a child. Understand\n                                what you really want now/.&nbsp;</li>\n                            <li><b>Give them a clear direction<br></b>Correctly formulate each of your desires. Create\n                                your perfect wishlist that works.</li>\n                            <li><b>You will remove obstacles that pretend your performance<br></b><span style=\"font-size: 1.1rem;\">Get rid of the accumulated negativity and imposed\n                                    stereotypes. Work through deep-seated fears and false beliefs.</span></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tyGSuluZxO",
          "_anchor": "content4-3y",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content04",
          "_sourceTheme": "artistm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"artistm5 content4\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"8\" value=\"6\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row jc-sb\">\n            <div class=\"col-12 col-md-12 col-lg-5\">\n                <h6 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    /01</h6>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                    <b>SENDERISMO</b></h5>\n                <p class=\"mbr-section-text mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-text\" mbr-theme-style=\"display-7\">Lorem ipsum dolor sit amet,\n                    consectetur adipiscing elit. In sed leo nec mi sodales egestas. Cras quis maximus diam. Sed cursus\n                    vulputate velit, id molestie leo pharetra in.<br><br>Curabitur dignissim varius massa iaculis\n                    egestas.</p>\n            </div>\n\n\n\n            <div class=\"col-12 col-md-12 col-lg-6\">\n\n                <h6 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    /02</h6>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                    <b>AWARDS</b>\n                </h5>\n\n\n\n                <div class=\"row\">\n                    <div class=\"col-md-6 col-lg-6\">\n                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            <b>PAINTING</b><br>2022 -&nbsp;Artist Award<br>2021 - Creative Event<br>2020 - Art\n                            Creative<br>2019 - Design Showcase<br>2018 - Painting Event\n                        </p>\n                    </div>\n\n                    <div class=\"col-md-6 col-lg-6\">\n                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            <b>PHOTOGRAPHY\n                            </b><br>2022 - Artist Award\n                            <br>2021 - Photo Event\n                            <br>2020 - Art Photo<br>2019 - Design Photo<br>2018 - Creative Photo\n                        </p>\n                    </div>\n\n                </div>\n            </div>\n\n\n\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".jc-sb": {
              "justify-content": "space-between"
            },
            ".mbr-text": {
              "line-height": "1.6"
            },
            ".row": {
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            }
          },
          "_cid": "tyGSulYhBY",
          "_anchor": "content04-3z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article03",
          "_sourceTheme": "pizzam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" />\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" />\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\n            condition=\"fullScreen == false\" />\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\n            condition=\"fullScreen == false\" />\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked />\n        <header>Text</header>\n        <input type=\"color\" title=\"Colored\" value=\"#a68462\" name=\"coloredTextColor\" />\n        <header>Column</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"colTitle\" checked />\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked />\n        <header>Row</header>\n        <select title=\"Amount\" name=\"rowsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/pizzam5/components/_images/image9.jpg\" />\n            <input type=\"color\" title=\"Color\" value=\"#414142\" selected />\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked />\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#414142\"\n            condition=\"overlay && bg.type !== 'color'\" />\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\"\n            condition=\"overlay && bg.type !== 'color'\" />\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n        bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"px-0 px-sm-3\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div mbr-if=\"showTitle\" class=\"row mx-0 mx-sm-5 mb-1\">\n            <div class=\"col-12 mb-5 px-sm-3\">\n                <h3 class=\"mbr-section-title main-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                    data-app-selector=\".mbr-section-title.main-title\" data-app-placeholder=\"Type Text\">\n                    <i class=\"colored-text\">Who</i> we are\n                </h3>\n            </div>\n        </div>\n        <div class=\"row mx-0 mx-sm-5\">\n            <div class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Our company</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Nisi voluptates dolores perferendis fugiat? Lorem ipsum,\n                        dolor sit amet consectetur adipisicing elit. Nesciunt\n                        deleniti magni unde tempore blanditiis nulla, omnis quas\n                        facere, quia dolorem eaque similique ipsum.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Our team</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Lorem ipsum dolor sit amet consectetur adipisicing elit.\n                        Amet nesciunt debitis quaerat ad blanditiis ipsa enim\n                        itaque. Animi repudiandae harum nihil vitae saepe\n                        necessitatibus, placeat mollitia in incidunt\n                        maiores.&nbsp;\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Testimonials</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Quae molestiae harum assumenda nihil, quisquam fugiat\n                        atque tenetur, delectus culpa ad nulla tempore error\n                        exercitationem. Pariatur explicabo non ab. Lorem, ipsum\n                        dolor sit amet consectetur adipisicing elit.&nbsp;\n                    </p>\n                </div>\n            </div>\n            <div mbr-if=\"rowsAmount > 1\" class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Daily fresh menu</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Volutpat sed cras ornare arcu dui vivamus arcu.\n                        Pellentesque elit ullamcorper dignissim cras. Vestibulum\n                        lectus mauris ultrices. Arcu ac tortor dignissim\n                        convallis aenean et tortor at risus.&nbsp;\n                    </p>\n                </div>\n            </div>\n            <div mbr-if=\"rowsAmount > 1\" class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Fresh delicious meals</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Est ullamcorper eget nulla facilisi etiam. Arcu non odio\n                        euismod lacinia at quis risus. Facilisis mauris sit amet\n                        massa vitae tortor condimentum lacinia\n                        quis.&nbsp;Placeat mollitia in incidunt maiores.\n                    </p>\n                </div>\n            </div>\n            <div mbr-if=\"rowsAmount > 1\" class=\"col-12 col-md-4 px-sm-3 mb-3\">\n                <div class=\"inner-content\">\n                    <h5 mbr-if=\"colTitle\" class=\"mbr-section-title col-title mbr-fonts-style pb-2\"\n                        mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\"\n                        data-app-placeholder=\"Type Text\">\n                        <i>Creative &amp; talented chefs</i>\n                    </h5>\n                    <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                        Malesuada nunc vel risus commodo viverra. Augue interdum\n                        velit euismod in pellentesque massa placerat. In est\n                        ante in nibh mauris cursus. Pariatur explicabo non ab.\n                        Augue, omnis.&nbsp;\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-section-title.col-title": {
              "color": "#a68462"
            },
            ".colored-text": {
              "color": "@coloredTextColor !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            }
          },
          "_cid": "tyGSump3UD",
