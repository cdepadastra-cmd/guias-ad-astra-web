        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title": {
              "border-bottom": "1px solid @borderColor"
            },
            ".card-wrapper": {
              "overflow": "hidden",
              "height": "100%",
              "background": "@cardColor",
              "color": "#444444",
              "padding": "0",
              "border": "1px solid @borderColor",
              "transition": "all 0.3s",
              "&:hover": {
                "box-shadow": "0 20px 30px rgba(0, 0, 0, 0.1)",
                "margin-top": "-0.6rem"
              },
              "&:hover .price-box": {
                "-webkit-transform": "scale(1.2)",
                "transform": "scale(1.2)",
                "left": "5px",
                "bottom": "15px"
              }
            },
            ".display-4": {
              "line-height": "1.1"
            },
            ".mbr-iconfont": {
              "font-size": "1rem",
              "padding-bottom": "3px"
            },
            ".ico-line-wrap": {
              "display": "flex",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between"
            },
            ".ico-line": {
              "display": "flex",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between"
            },
            "p": {
              "line-height": "1.6"
            },
            ".btn-danger-outline": {
              "border": "none",
              "background": "transparent",
              "font-weight": "400 !important"
            },
            ".card-title": {
              "color": "#000000",
              "margin": "0",
              "line-height": "1.3",
              "text-align": "left"
            },
            ".card-img": {
              "overflow": "hidden",
              "max-height": "280px",
              "position": "relative",
              "border-radius": "0"
            },
            ".price-box": {
              "position": "absolute",
              "background": "@priceColor",
              "padding": "0.5rem 1rem",
              "left": "0",
              "bottom": "1rem",
              "transition": "all 0.3s"
            },
            "img": {
              "transition": "all 0.3s"
            },
            "h5": {
              "margin": "0"
            },
            ".card-box": {
              "padding": "1.5rem"
            },
            ".mbr-section-title": {
              "margin": "0 auto",
              "color": "#000000",
              "text-align": "left"
            },
            ".card-box > p, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-section-sub-title": {
              "text-align": "center",
              "color": "#9e9e9e"
            },
            ".price": {
              "color": "#000000",
              "text-align": "left"
            },
            ".rev": {
              "color": "#000000"
            },
            "@media (max-width: 576px)": {
              ".ico-line-wrap": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column"
              },
              ".ico-line": {
                "-webkit-justify-content": "flex-start",
                "justify-content": "flex-start"
              }
            }
