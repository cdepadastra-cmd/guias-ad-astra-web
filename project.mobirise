div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">30€</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/covacha.jpg-410x307.jpg\" title alt>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">\n\t\t\t\t\t\t\tLaguna del Barco</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Sierra de Gredos (Ávila)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-calendar\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></div>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">4 de julio de 2026<br></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">30€</h5>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/p6290701.jpg-692x519.jpg\" title alt>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Travesía de Peñalara</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Sierra de Guadarrama (Madrid-Segovia)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-calendar\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></div>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">21 de junio<br></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
