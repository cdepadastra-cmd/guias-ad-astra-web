        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title": {
              "border-bottom": "1px solid @borderColor"
            },
            ".card-wrapper": {
              "overflow": "hidden",
              "height": "100%",
              "background": "@cardColor",
              "color": "#444444",
              "padding": "0",
              "border": "1px solid @borderColor",
              "transition": "all 0.3s",
              "&:hover": {
                "box-shadow": "0 20px 30px rgba(0, 0, 0, 0.1)",
                "margin-top": "-0.6rem"
              },
              "&:hover .price-box": {
                "-webkit-transform": "scale(1.2)",
                "transform": "scale(1.2)",
                "left": "5px",
                "bottom": "15px"
              }
            },
            ".display-4": {
              "line-height": "1.1"
            },
            ".mbr-iconfont": {
              "font-size": "1rem",
              "padding-bottom": "3px"
            },
            ".ico-line-wrap": {
              "display": "flex",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between"
            },
            ".ico-line": {
              "display": "flex",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between"
            },
            "p": {
              "line-height": "1.6"
            },
            ".btn-danger-outline": {
              "border": "none",
              "background": "transparent",
              "font-weight": "400 !important"
            },
            ".card-title": {
              "color": "#000000",
              "margin": "0",
              "line-height": "1.3",
              "text-align": "left"
            },
            ".card-img": {
              "overflow": "hidden",
              "max-height": "280px",
              "position": "relative",
              "border-radius": "0"
            },
            ".price-box": {
              "position": "absolute",
              "background": "@priceColor",
              "padding": "0.5rem 1rem",
              "left": "0",
              "bottom": "1rem",
              "transition": "all 0.3s"
            },
            "img": {
              "transition": "all 0.3s"
            },
            "h5": {
              "margin": "0"
            },
            ".card-box": {
              "padding": "1.5rem"
            },
            ".mbr-section-title": {
              "margin": "0 auto",
              "color": "#000000",
              "text-align": "left"
            },
            ".card-box > p, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-section-sub-title": {
              "text-align": "center",
              "color": "#9e9e9e"
            },
            ".price": {
              "color": "#000000",
              "text-align": "left"
            },
            ".rev": {
              "color": "#000000"
            },
            "@media (max-width: 576px)": {
              ".ico-line-wrap": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column"
              },
              ".ico-line": {
                "-webkit-justify-content": "flex-start",
                "justify-content": "flex-start"
              }
            }
          },
          "_name": "features6",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section class=\"features6 travelm4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t</select>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Main Title\" name=\"showMaintitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Cards\" name=\"cardColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#ececec\">\n\t\t<input type=\"color\" title=\"Price\" name=\"priceColor\" value=\"#edff00\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-md-12\">\n\t\t\t\t<h2 class=\"mbr-section-title title pb-2 mb-1 mbr-bold mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showMaintitle\" data-app-selector=\".mbr-section-title\">ESCALADA EN ZAMORA</h2>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row row-content justify-content-center\">\n            \n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">30€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        <a href=\"senderismo-avila-gredos.html\" class=\"text-primary\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            </a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Bautismo en escalada</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Fuentidueña (Segovia)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;1h30´</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 5<br>Rapel más largo: 15m.<br></span><span style=\"font-weight: normal;\">Saltos: Si</span><div><span style=\"font-weight: normal;\">Toboganes: No</span></div></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"contacto-reservas.html\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">35€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        <a href=\"senderismo-avila-gredos.html\" class=\"text-primary\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            </a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Perfeccionamiento en escalada</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Fuentidueña (Segovia)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social fa-star-o fa\" style=\"color: rgb(158, 158, 158); fill: rgb(158, 158, 158);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;1h30´</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 9<br>Rapel más largo: 30m.<br>Saltos: No<br>Toboganes: Si</span><span style=\"font-weight: normal;\"><br></span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"contacto-reservas.html\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">95€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        <a href=\"senderismo-avila-gredos.html\" class=\"text-primary\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            </a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Curso de iniciación a la escalada</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Fuentidueña (Segovia)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;8 horas</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 18<br>Rapel más largo: 30m.<br>Saltos: Si<br>Toboganes: Si</span><span style=\"font-weight: normal;\"><br></span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"contacto-reservas.html\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
