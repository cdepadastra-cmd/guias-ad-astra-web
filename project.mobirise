          "_name": "menu1",
          "_customHTML": "<section class=\"menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <select title=\"Widget Count\" name=\"widgetCount\" condition=\"topmenu\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <select title=\"Menu Align\" name=\"menuAlign\">\n            <option value=\"left\">Left</option>\n            <option value=\"center\" selected>Center</option>\n            <option value=\"right\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Top Menu\" name=\"topmenu\" checked>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" condition=\"topmenu\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" condition=\"topmenu\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" condition=\"topmenu\" checked>\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.2\" value=\"4\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#5f90f5\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\" mbr-if=\"topmenu\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-adastra-pequeo-186x249.png\" alt=\"Guías Ad Astra\" mbr-style=\"{'height': logoSize + 'rem'}\" title>\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-5\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a href=\"https://mobirise.com\" class=\"brand-link mbr-black text-danger\" data-app-selector=\".brand-link\" data-app-placeholder=\"Type Text\">\n                            Guías AdAstra</a></span>\n                </div>\n            </div>\n            <div class=\"menu-content-right\">\n                <div class=\"info-widget\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mbri-mobile2\" style=\"color: rgb(222, 249, 12); fill: rgb(222, 249, 12);\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">621 075 048</p>\n                        <p class=\"widget-text mbr-fonts-style\" data-app-selector=\".widget-text\" mbr-theme-style=\"display-4\">guiasadastra@gmail.com</p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 1\">\n                    <span mbr-icon class=\"widget-icon mbr-iconfont mbri-clock\" style=\"color: rgb(222, 249, 12); fill: rgb(222, 249, 12);\"></span>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">Lun - Vie: 9:00 - 18:00</p>\n                        <p class=\"widget-text mbr-fonts-style\" data-app-selector=\".widget-text\" mbr-theme-style=\"display-4\">Sab - Dom: Por mensaje</p>\n                    </div>\n                </div>\n                <div class=\"info-widget\" mbr-if=\"widgetCount > 2\">\n                    <span mbr-icon class=\"widget-icon mbri-letter mbr-iconfont\"></span>\n                    <div class=\"widget-content mbr-fonts-style\">\n                        <p class=\"widget-title\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\">office@example.com</p>\n                        <p class=\"widget-text mbr-fonts-style\" data-app-selector=\".widget-text\" mbr-theme-style=\"display-4\">info@medical.com</p>\n                    </div>\n                </div>\n\n\n\n\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-md btn-primary\" href=\"contacto-reservas.html\" data-app-placeholder=\"Type Text\">\n                        \n\n                        Contacto</a></div>\n\n\n\n\n\n\n            </div>\n        </div>\n        <div class=\"menu-bottom\">\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            INICIO</a>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-white text-primary\" href=\"calendario-actividades-gredos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CALENDARIO</a></li><li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">ACTIVIDADES</a><div class=\"dropdown-menu\"><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Barranquismo</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-avila.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Ávila</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-en-caceres.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cáceres</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-leon.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">León</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-madrid-segovia.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Madrid</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-salamanca.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Salamanca</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-madrid-segovia.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Segovia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-palencia.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Palencia</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"barranquismo-cueva-valporquero-sima-de-perlas.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Barranco-Cueva de Valporquero</a><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Vías ferratas</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"via-ferrata-burgos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Burgos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"vias-ferratas-leon.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">León</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"via-ferrata-salamanca.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Salamanca</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Espeleología</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"espeleologia-leon.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">León</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"espeleologia-segovia.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Segovia</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Escalada</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">León</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Palencia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Salamanca</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Zamora</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"ascensiones-montana.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Ascensiones</a><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Senderismo</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Ávila</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">León</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Palencia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Salamanca</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Valladolid</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item text-white text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Grandes travesías</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"trekking-carros-de-foc.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Carros de Foc (Pirineos)</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Rutas invernales</a></div></li>\n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">VIAJES</a><div class=\"dropdown-menu\"><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Alpes</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Tour del Mont Blanc</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Ferratas de los Dolomitas</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item text-white dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Grecia</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"monte-olimpo.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Trekking del Monte Olimpo</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Himalaya</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Campamento Base Everest</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Campamento Base K2</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Treking de los Annapurna</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Islandia</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">El Círculo Dorado</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Cascadas de Islandia</a><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">La Gran Travesía</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Islas Canarias</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Ascensión al Teide</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Madeira</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Barranquismo en Madeira</a></div></div><div class=\"dropdown\"><a class=\"mbr-black dropdown-item dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Marruecos</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Ascensión Toukbal</a></div></div></div></li>\n\n                    \n                    \n                    \n                    <li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">\n                            CURSOS</a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"curso-autorrescate.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Curso de Autorrescate</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"cursos-alpinismo.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Cursos de Alpinismo</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"curso-arva.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Curso de ARVA y rescate de víctimas de avalanchas</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"curso-barranquismo.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cursos de Barranquismo</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"curso-iniciacion-escalada-en-roca.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Cursos de Escalada</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Curso de Orientación</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Curso de Vías Ferratas</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">OTROS</a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"organizacion-eventos-deportivos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Organización de eventos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"comarca-natural-oeste-de-gredos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Comarca Natural Oeste de Gredos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"via-verde-ruta-de-la-plata.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Vía Verde Ruta de la Plata</a><div class=\"dropdown\"><a class=\"mbr-black dropdown-item text-white text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Nuestros eventos</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"gredos-limpio.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Gredos Limpio</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"https://www.ultratrailgredos.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">Ultra de Gredos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"https://www.desafiobttfuenterrico.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">Desafío BTT Fuenterrico</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Iniciativas de turismo rural</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Creación, mantenimiento de senderos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Servicio de Route Setting</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"boulder-las-tuerces.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Boulder en Las Tuerces, Palencia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"boulder-zona-centro-salamanca-caceres.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Boulder en la Zona Centro (Ávila, Cáceres y Salamanca)</a></div></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-white text-primary\" href=\"alquiler-material-montana.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ALQUILER MATERIAL</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-white text-primary\" href=\"blog.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">BLOG</a></li></ul>\n\n            </div>\n            <button class=\"navbar-toggler \" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n           