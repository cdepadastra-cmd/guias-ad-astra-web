          "_name": "accordion1",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section class=\"accordion1 travelm4_accordion1\" group=\"Accordions\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n\t\t<select title=\"Accordions\" name=\"bootstrapAccordion\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\" selected>6</option>\n\t\t</select>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Accordion\" name=\"accordionColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Panel\" name=\"panelColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#ececec\">\n\t\t<input type=\"color\" title=\"Icon\" name=\"icon\" value=\"#ff4a52\">\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-md-10\">\n\t\t\t\t<h2 class=\"mbr-section-title align-center mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Cursos y eventos programadas</h2>\n\t\t\t\t<h3 class=\"mbr-section-subtitle pt-2 align-center mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">A parte de estos cursos y eventos programadas hacemos actividades de montaña en más fechas, incluido entre semana.\n<div>Y si tienes un grupo nos adaptamos a las situaciones.</div></h3>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row pt-3 justify-content-center\">\n\t\t\t<div class=\"col-md-10 accordion-section\">\n\t\t\t\t<div class=\"accordion-content\">\n\t\t\t\t\t<div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n\t\t\t\t\t\t<div class=\"card\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tENERO</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Sábado 17 de enero:</b> CURSO INICIACIÓN TÉCNICAS INVERNALES (Gredos)<br><b>- Sábado 24 de enero:</b> CURSO INICIACIÓN TÉCNICAS INVERNALES.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tFEBRERO</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Sábado 7 de febrero:</b> CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)<br><b>- Sábado 28 de febrero: </b>CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tMARZO</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Domingo 1 de marzo:</b> CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)<br><b>- Sábado 7 de marzo: </b>CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)<br><b>- Sábado 21 de marzo: </b>CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tABRIL</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Sábado 11 de abril:</b> CURSO INICIACIÓN TÉCNICAS INVERNALES. (Gredos)\n<br><b>- Sábado 18 de abril: </b>CURSO INICIACIÓN TÉCNICAS INVERNALES.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tMAYO</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Sábado 2 y Domingo 3 de mayo: </b>CURSO BARRANQUISMO (Gredos)\n<br><b>- Sábado 9 y Domingo 10 de mayo:</b> CURSO BARRANQUISMO (Gredos)\n<br><b>- Sábado 16 de mayo:</b> DESAFÍO BTT FUENTERRICO (<a href=\"https://www.desafiofuenterrico.com\" class=\"text-primary\" target=\"_blank\">www.desafiofuenterrico.com</a>) (Salamanca)<br><b>- Sábado 30 y Domingo 31 de mayo:</b> CURSO AUTORRESCATE EN ENTORNOS VERTICALES (válido para barranquismo, ferratas, alpinismo y escalada)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont icon mbri-arrow-next inactive\"></span>\n\t\t\t\t\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-fonts-style header-text mbr-bold\" mbr-theme-style=\"display-7\" data-app-selector=\".header-text, .sign\">\n\t\t\t\t\t\t\t\t\t\t\tJUNIO</h4>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body p-4\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><b>- Sábado 6 y Domingo 7 de junio:</b> CURSO AUTORRESCATE EN ENTORNOS VERTICALES (válido para barranquismo, ferratas, alpinismo y escalada)\n<br><b>- Sábado 13 y Domingo 14 de junio: </b>CURSO BARRANQUISMO (Gredos)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "v8dylC2lEp",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "accordion1-qi"
        },
        {
          "_name": "afooter1",
          "_sourceTheme": "expertm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container": {
              "width": "100%",
              "max-width": "1310px",
              "@media (max-width: 1199px)": {
                "max-width": "960px"
              },
              "@media (max-width: 991px)": {
                "max-width": "720px"
              },
              "@media (max-width: 767px)": {
                "max-width": "540px"
              },
              "@media (max-width: 575px)": {
                "max-width": "100%",
                ".row": {
                  "> [class*=\"col\"]": {
                    "padding-left": "20px",
                    "padding-right": "20px"
                  }
                }
              }
            },
            ".item-wrap": {
              "width": "100%"
            },
            ".navbar-brand": {
              "display": "flex",
              "flex-basis": "100%",
              "flex-wrap": "wrap",
              "word-break": "break-word !important",
              "word-wrap": "break-word !important",
              "min-height": "50px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "margin-bottom": "35px",
              "padding": "0",
              "transition": "all 0.4s",
              "z-index": "1",
              "white-space": "normal",
              ".navbar-logo": {
                "margin-right": "0.5rem",
                "img": {
                  "width": "auto"
                }
              },
              ".navbar-caption": {
                "line-height": "inherit !important",
                "word-break": "break-word !important",
                "word-wrap": "break-word !important",
                "&:hover": {
                  "text-decoration-line": "none !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none",
                "word-break": "break-word !important",
                "word-wrap": "break-word !important",
                "&:hover": {
                  "text-decoration-line": "none !important"
                }
              }
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-4px -12px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "4px 12px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                "&:before": {
                  "opacity": "1"
                }
              }
            },
            ".col-links": {
              "@media (max-width: 767px)": {
                "padding-top": "20px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#19a6fa",
              "margin-bottom": "20px",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              }
            },
            ".list": {
              "width": "100%",
              "list-style": "none",
              "padding-left": "0",
              "margin-bottom": "40px",
              "color": "#C4CFDE",
              "transition": "0.4s all",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              },
              "li": {
                "width": "100%",
                "color": "inherit !important",
                "margin-bottom": "8px",
                "transition": "0.4s all",
                "&:not(:first-child)": {
                  "margin-top": "10px"
                }
              },
              "a": {
                "position": "relative",
                "color": "inherit !important",
                "line-height": "inherit !important",
                "transition": "0.4s all",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "width": "0",
                  "height": "1px",
                  "background-color": "@primaryColor",
                  "transition": "0.4s all"
                },
                "&:hover": {
                  "color": "@primaryColor !important",
                  "line-height": "inherit !important",
                  "&:before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".col-copyright": {
              "padding-top": "80px",
              "@media (max-width: 767px)": {
                "padding-top": "40px"
              }
            },
            ".border-item": {
              "width": "100%",
              "height": "1px",
              "background-color": "@borderColor"
            },
            ".copyright": {
              "color": "#C4CFDE",
              "padding": "40px 0"
            }
          },
          "_customHTML": "<section class=\"footer1 expertm5\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footers\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Content Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"range\" name=\"listCount\" title=\"List Count\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#1e2024\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked condition=\"showCopyright\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#16181c\" condition=\"showBorder && showCopyright\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#212428\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-sm-6 col-lg-3\" mbr-if=\"showLogo || showBrand || showSocial\">\n                <div class=\"item-wrap\">\n                    <div class=\"navbar-brand\" mbr-if=\"showLogo || showBrand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-adastra-pequeo-186x249.png\" alt=\"Guías Ad Astra\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                        <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white text-primary\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Ad Astra<br>Montaña y Aventura<br></a></span>\n                    </div>\n                    <div class=\"social-list\" mbr-if=\"showSocial\">\n                        <div class=\"soc-item\" mbr-if=\"socialCount>0\">\n                            <a href=\"https://www.instagram.com/guias_adastra/?hl=af\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span></a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                            <a href=\"https://www.facebook.com/guiasadastra/?locale=es_ES\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span></a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                            <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                            <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                            <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                            <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        ACTIVIDADES</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Senderismo</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Ascensiones</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Barranquismo</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Vías ferratas</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Escalada</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Espeleología</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Rutas invernales</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Alquiler de material</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Cursos</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Organización de eventos</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\" mbr-if=\"listCount > 1\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        INFORMACIÓN</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><a href=\"calendario-actividades-gredos.html\" class=\"text-primary\">Calendario actividades</a></li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Sobre nosotros</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Dónde estamos</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Blog</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Condiciones generales</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Política de cookies</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\" mbr-if=\"listCount > 2\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        CONTACTO</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Teléfono:</b> 621 075 048</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Correo:</b> guiasadastra@gmail.com</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Dirección: </b></li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">- Fuentes de Béjar (Salamanca).<br>- Vallespinoso de Cervera (Palencia).<br>- Valladolid (Valladolid).</li>\n                    </ul>\n                </div>\n            </div>\n\n\n        </div>\n        <div class=\"row\" mbr-if=\"showCopyright\">\n            <div class=\"col-12 col-copyright\">\n                <div class=\"border-item\" mbr-if=\"showBorder\"></div>\n                <p class=\"mbr-text mb-0 mbr-fonts-style copyright align-center\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2023&nbsp;<a href=\"https://www.cordonesweb.es\" class=\"text-success\" target=\"_blank\">CordonesWeb</a> - Todos los derechos reservados.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "afooter1-4r",
          "_isUserblock": true,
          "_cid": "tyH20ztVnz",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
