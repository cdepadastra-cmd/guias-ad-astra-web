                }
              },
              "img": {
                "width": "300px",
                "max-height": "450px",
                "border-radius": "300px 300px 0 0",
                "z-index": "2",
                "position": "relative",
                "@media (max-width: 992px)": {
                  "margin": "0 auto"
                }
              }
            },
            ".text-wrapper": {
              "padding-right": "110px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@reverseContent)": {
                "padding-right": "0",
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "15px"
              },
              ".mbr-text": {
                "margin-bottom": "16px"
              }
            },
            ".cards": {
              ".card": {
                "margin-bottom": "20px",
                ".mbr-number": {
                  "margin": "0"
                },
                ".mbr-desc": {
                  "margin": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ee2947"
            },
            ".mbr-text": {
              "color": "#1e4381"
            },
