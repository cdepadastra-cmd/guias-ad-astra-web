          "_name": "header1",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/img-20180330-125459-2000x1503.jpg\" selected parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#886586\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#333333\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-column mbr-white col-md-10 offset-md-1\">\n            <h1 class=\"mbr-section-title align-center mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                <br>BARRANQUISMO EN ÁVILA</h1>\n            <h3 class=\"mbr-section-subtitle align-center mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\"><b>\n                Barranquismo en Cáceres (Gredos)</b></h3>\n            <p class=\"mbr-text align-center pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Descenso de barrancos en el Valle del Jerte y Gredos</p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"reservas.html\" data-app-placeholder=\"Type Text\"><span class=\"mbri-cart-add mbr-iconfont mbr-iconfont-btn\"></span>\n                    \n                    RESERVAR</a></div>\n        </div>\n    </div>\n\n</section>",
          "_anchor": "header1-4l",
          "_isUserblock": true,
          "_cid": "tyGTdO48zN",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-img": {
              "span": {
                "color": "@iconColor",
                "font-size": "~\"@{icon1}rem\""
              }
            },
            ".mbr-text": {
              "color": "#656565"
            },
            "p": {
              "margin": "0"
            },
            "@media (max-width: 576px)": {
              ".card": {
                "margin-bottom": "2rem"
              }
            },
            ".card-title, .card-img": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "text-align": "center"
            },
            ".mbr-section-sub-title": {
              "text-align": "center",
              "color": "#9e9e9e"
            }
          },
          "_name": "features2",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section class=\"features2 travelm4_features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t</select>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Main Title\" name=\"showMaintitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Main Subtitle\" name=\"showMainsubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<header>Icon</header>\n\t\t<input type=\"checkbox\" title=\"Show\" name=\"showIcon\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#1ec6b6\" condition=\"showIcon\">\n\t\t<input type=\"range\" inline title=\"Size\" name=\"icon1\" min=\"1\" max=\"10\" step=\"0.1\" value=\"2.9\" condition=\"showIcon\">\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<h2 class=\"mbr-section-title pb-2 mbr-bold mbr-fonts-style align-left\" mbr-theme-style=\"display-2\" mbr-if=\"showMaintitle\" data-app-selector=\".mbr-section-title\">Info técnica</h2>\n\n\t\t<h3 class=\"mbr-section-sub-title pb-4 mbr-normal mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showMainsubtitle\" data-app-selector=\".mbr-section-sub-title\">\n\t\t\tLorem ipsum dolor sit amet, consectetur elit\n\t\t</h3>\n\n\t\t<div class=\"media-container-row\">\n\t\t\t<div class=\"card p-3 col-12 col-md-6 border-r\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"card-img pb-3\" mbr-if=\"showIcon\">\n\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v2-group-1\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t<h4 class=\"count card-title mbr-fonts-style mbr-white mbr-bold align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-img\">\n\t\t\t\t\t\tGrupo mínimo</h4>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-white mbr-normal align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t1 persona</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6 border-r\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"card-img pb-3\" mbr-if=\"showIcon\">\n\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v1-stop-watch1\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t<h4 class=\"count card-title mbr-fonts-style mbr-white mbr-bold align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-img\">\n\t\t\t\t\t\tDuración</h4>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-white mbr-normal align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">&nbsp;6 horas</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6 border-r\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"card-img pb-3\" mbr-if=\"showIcon\">\n\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont icon54-v4-flash\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t<h4 class=\"count card-title mbr-fonts-style mbr-white mbr-bold align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-img\">\n\t\t\t\t\t\tDificultad</h4>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-white mbr-normal align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\tMedia</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3'}\">\n\t\t\t\t<div class=\"card-img pb-3\" mbr-if=\"showIcon\">\n\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont imind-boy\"></span>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t<h4 class=\"count card-title mbr-fonts-style mbr-white mbr-bold align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-img\">\n\t\t\t\t\t\tEdad mínima</h4>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-white mbr-normal align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n\t\t\t\t\t\t14 años</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "tyFLUgXBQO",
          "_anchor": "features2-l",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article03",
          "_sourceTheme": "nichem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"nichem5 article3\" group=\"Article\"\n    data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"7\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/nichem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#6be3ff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/nichem5/components/_images/background1.jpg\" name=\"fallBackImage\"\n            condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n        bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}} image-wrapper\">\n                <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/features1.jpg\" alt=\"Mobirise Website Builder\">\n            </div>\n            <div class=\"col-12 col-md-12 col-lg\">\n                <div class=\"text-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style align-left mb-4\" data-app-selector=\".mbr-section-title\"\n                        mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>OUR COMPANY</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style align-left pb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\"\n                        data-app-selector=\".mbr-text, .text-wrapper\">\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean lacus dolor, placerat et turpis\n                        id, malesuada hendrerit velit. Etiam lobortis, tortor eu efficitur laoreet, velit mauris\n                        consectetur velit, at facilisis lacus nibh quis nibh. Sed ullamcorper metus sed massa blandit\n                        tempus. Ut lacinia et odio ac fringilla. In hac habitasse platea dictumst. Pellentesque habitant\n                        morbi tristique senectus et netus et malesuada fames ac turpis egestas.</p>\n                    <div class=\"link-wrapper align-left\">\n                        <p class=\"mbr-link align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showButtons\"\n                            data-app-selector=\".mbr-link, .text-wrapper, path\"><b>READ MORE</b></p>\n\n\n                        <svg class=\"svg1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n                            version=\"1.1\" width=\"300\" height=\"50\" viewBox=\"0 0 300 50\"\n                            preserveAspectRatio=\"xMidYMid slice\" xml:space=\"preserve\">\n                            <defs>\n                            </defs>\n                            <g transform=\"matrix(1 0 0 1 200 4.59)\">\n                                <g style>\n                                    <g transform=\"matrix(1 0 0 1 -125 0)\" id=\"aac4a38b-7b64-4b27-81f4-7cba1fc44311\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-75, -4.59)\"\n                                            d=\"M 100 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 87.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 50 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 75 0)\" id=\"bdacfd93-3ab9-4965-b36c-24275b9d80d7\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-275, -4.59)\"\n                                            d=\"M 300 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 287.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 250 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 -175 0)\" id=\"fa02ee22-c807-4234-a62a-6ef55f12a121\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-25, -4.59)\"\n                                            d=\"M 50 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 37.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 0 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 -25 0)\" id=\"f5eeec8a-c1c0-4e31-b653-6adc33e4b3e8\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-175, -4.59)\"\n                                            d=\"M 200 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 187.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 150 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 125 0)\" id=\"b51bbcd5-3066-47f5-8b80-6fd345774dc4\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-325, -4.59)\"\n                                            d=\"M 350 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 337.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 300 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 175 0)\" id=\"a258efd3-c8f0-4dd9-8a96-69ce4b07fe50\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-375, -4.59)\"\n                                            d=\"M 400 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 387.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 350 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 -75 0)\" id=\"b55a1ba9-a72e-4a0e-ba97-85e004b73874\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-125, -4.59)\"\n                                            d=\"M 150 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 137.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 100 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                    <g transform=\"matrix(1 0 0 1 25 0)\" id=\"ac2b4d02-8806-4f29-a2a5-1942e82a5fe8\">\n                                        <path\n                                            style=\"stroke: rgb(23,0,59); stroke-width: 4; stroke-dasharray: none; stroke-linecap: butt; stroke-dashoffset: 0; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;\"\n                                            transform=\" translate(-225, -4.59)\"\n                                            d=\"M 250 2 a 8.825 8.825 0 0 0 -6.25 2.583 A 8.822 8.822 0 0 1 237.5 7.17 a 8.822 8.822 0 0 1 -6.25 -2.584 a 8.853 8.853 0 0 0 -12.5 0 a 8.851 8.851 0 0 1 -12.5 0 A 8.825 8.825 0 0 0 200 2\"\n                                            stroke-linecap=\"round\"></path>\n                                    </g>\n                                </g>\n                            </g>\n                        </svg>\n\n                    </div>\n\n\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
