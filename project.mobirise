                }
              },
              "a": {
                "position": "relative",
                "color": "inherit !important",
                "line-height": "inherit !important",
                "transition": "0.4s all",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "width": "0",
                  "height": "1px",
                  "background-color": "@primaryColor",
                  "transition": "0.4s all"
                },
                "&:hover": {
                  "color": "@primaryColor !important",
                  "line-height": "inherit !important",
                  "&:before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".col-copyright": {
              "padding-top": "80px",
              "@media (max-width: 767px)": {
