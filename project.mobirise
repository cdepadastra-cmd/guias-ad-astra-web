          "_name": "features6",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section class=\"features6 travelm4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n\t\t<select title=\"Cards\" name=\"cardsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t</select>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Main Title\" name=\"showMaintitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Cards\" name=\"cardColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Border\" name=\"borderColor\" value=\"#ececec\">\n\t\t<input type=\"color\" title=\"Price\" name=\"priceColor\" value=\"#edff00\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-md-12\">\n\t\t\t\t<h2 class=\"mbr-section-title title pb-2 mb-1 mbr-bold mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showMaintitle\" data-app-selector=\".mbr-section-title\">ÁVILA, CÁCERES Y SALAMANCA (Sierra de Gredos)</h2>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row row-content justify-content-center\">\n            \n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">55€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        \n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            \n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Barranco de Papúos</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Jerte (Cáceres)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;6-7 horas<br></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 9<br>Rapel más largo: 30m.<br>Saltos: Si<br>Toboganes: 4</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"barranco-de-papuos.html\" data-app-placeholder=\"Type Text\">Más info</a> <a class=\"btn btn-secondary-outline\" href=\"https://buy.stripe.com/cN228A1PweiddwseUU\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">35€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        \n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            \n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Barranco de los Hoyos</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Jerte (Cáceres)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;3-4 horas</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 5<br>Rapel más largo: 15m.<br>Saltos: Si<br>Toboganes: 3</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"contacto-reservas.html\" data-app-placeholder=\"Type Text\">Más info</a> <a class=\"btn btn-secondary-outline\" href=\"data:application/json,%7B%22type%22%3A%22_cart%22%2C%22item_name%22%3A%22Barranco%20de%20los%20Hoyos%22%2C%22email%22%3A%22guiasadastra%40gmail.com%22%2C%22price%22%3A%2235.00%22%2C%22oldPrice%22%3A%22%22%2C%22currency_code%22%3A%22EUR%22%2C%22description%22%3A%22Barranco%20de%20los%20Hoyos%22%2C%22images%22%3A%22%22%2C%22option1%22%3Anull%2C%22option2%22%3Anull%2C%22option3%22%3Anull%2C%22allPrice%22%3A%22%22%2C%22variants1%22%3Anull%2C%22variants2%22%3Anull%2C%22variants3%22%3Anull%7D\" data-app-placeholder=\"Type Text\" target=\"_blank\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 2\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">45€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        \n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/16-2-355x400.png\" title alt>\n                            \n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Barranco del Arbillas</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Poyales del Hoyo (Ávila)</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;3-4 horas</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 6<br>Rapel más largo: 30m.<br>Saltos: Si<br>Toboganes: 1</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">El Barranco de los Papúos es sin duda el mejor barranco de toda la zona centro y uno de los mas divertidos y completos de todo el panorama nacional.\n</span><br><span style=\"font-weight: normal;\">Una joya de la Sierra de Gredos escondida entre los cerezos del Valle del Jerte. </span><br><span style=\"font-weight: normal;\">Muy cerca de Salamanca, Ávila y Madrid.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"barranco-del-arbillas.html\" data-app-placeholder=\"Type Text\">Más info</a> <a class=\"btn btn-secondary-outline\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=45&item_name=Barranco%20del%20Arbillas&currency_code=EUR&dataShop=smartCart\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
