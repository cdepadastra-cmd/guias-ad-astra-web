simples y complejas.<b><br></b></p>\n                </div>\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-secondary\" href=\"reservas.html\" data-app-placeholder=\"Type Text\">30€/persona</a> <a class=\"btn btn-md btn-secondary-outline\" href=\"curso-autodetenciones.html\" data-app-placeholder=\"Type Text\">MÁS INFO</a></div>\n            </div>\n        </div>\n    </div>\n\n</section>",
