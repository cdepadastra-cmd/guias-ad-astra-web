              }
            },
            ".image-wrapper": {
              "padding-left": "150px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "padding": "0",
                "margin-bottom": "40px"
              },
              "& when (@reverseContent)": {
                "display": "flex",
                "justify-content": "flex-end",
                "padding-left": "0",
                "padding-right": "150px",
                "@media (max-width: 992px)": {
                  "display": "block",
                  "padding": "0",
                  "margin-bottom": "40px"
                }
              },
              "& when (@showCircle)": {
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "left": "-1rem",
                  "bottom": "-7rem",
                  "display": "block",
                  "width": "300px",
                  "height": "300px",
                  "border": "30px solid @circle",
                  "border-radius": "50%",
                  "background-color": "transparent",
                  "z-index": "5",
                  "& when (@reverseContent)": {
                    "left": "auto",
                    "right": "-1rem"
                  },
                  "@media (max-width: 992px)": {
                    "display": "none"
