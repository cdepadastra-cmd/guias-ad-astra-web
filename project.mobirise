        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "@media (min-width: 1500px)": {
              ".container": {
                "max-width": "1400px"
              }
            },
            "img": {
              "width": "80%",
              "height": "auto",
              "margin": "auto"
            },
            ".content": {
              "margin": "auto"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#999999"
            },
            "@media (max-width: 1200px)": {
              "img": {
                "width": "100%"
              }
            },
            "@media (max-width: 992px)": {
              ".img-col": {
                "padding-bottom": "2rem"
              }
            },
            ".quote": {
              "color": "#200960"
            },
            "H3": {
              "color": "#200960"
            },
            "H4": {
              "color": "#d58f76"
            }
          },
          "_name": "content1",
          "_sourceTheme": "therapym4",
          "_customHTML": "<section group=\"Content\" class=\"content1 theraphym4_content1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" />\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\" />\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\" />\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked />\n        <input type=\"checkbox\" title=\"Show Sub Title\" name=\"showsubTitle\" checked />\n        <input type=\"checkbox\" title=\"Show Quote\" name=\"showText\" checked />\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/therapym4/components/_images/background1.jpg\" parallax />\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected />\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" />\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked />\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\" />\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n            condition=\"overlay && bg.type !== 'color'\" />\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n        bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"img-col col-12 md-pb col-md-6 align-center col-lg-4\">\n                <img src=\"@PROJECT_PATH@/assets/images/01.jpg\" alt=\"Mobirise\" />\n            </div>\n\n            <div class=\"mbr-black col-md-6 col-lg-4\">\n                <div class=\"content align-left mbr-white\">\n                    <h4 class=\"mbr-section-subtitle mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                        mbr-if=\"showsubTitle\">\n                        WELCOME NOTE\n                    </h4>\n                    <h3 class=\"mbr-section-title mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showTitle\">\n                        The latest edition\n                    </h3>\n                    <p class=\"mbr-text pb-3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text\">\n                        Duis aute irure dolor in reprehenderit in voluptate\n                        velit esse cillum dolore eu fugiat nulla pariatur. Lorem\n                        ipsum dolor sit amet, consectetur adipisicing elit, sed\n                        do eiusmod tempor incididunt ut labore et dolore magna\n                        aligua esse.\n                        <br />\n                    </p>\n                    <p class=\"mbr-text quote pb-3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        mbr-if=\"showText\" data-app-selector=\".quote\">\n                        \"Lorem ipsum dolor sit amet, consectetur adipiscing\n                        elit. Donec ullamcorper neque dapibus ipsum semper, sit\n                        amet luctus turpis porttitor. Ut libero ante, varius\n                        quis ligula in, aliquet consectetur tortor.\"\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"mbr-black col-md-12 col-lg-4\">\n                <div class=\"content align-left mbr-white\">\n                    <p class=\"mbr-text pb-3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                        data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Lorem ipsum dolor sit amet, consectetur adipisicing\n                        elit, sed do eiusmod tempor incididunt ut labore et\n                        dolore magna aliqua. Ut enim ad minim veniam, quis\n                        nostru exercitation ullamco laboris nisi ut aliquip ex\n                        lorem ipsum.\n                        <br />\n                        <br />\n                        Duis aute irure dolor in reprehenderit in voluptate\n                        velit esse cillum dolore eu fugiat.\n                        <br />\n                        <br />\n                        Excepteur sint occaecat cupidatat non proident, sunt in\n                        culpa qui officia deserunt mollit anim id est laborum.\n                        Sed ut perspiciatis unde omnis iste natus error\n                        sit.&nbsp;Duis aute irure dolor in reprehenderit in\n                        voluptate velit esse cillum dolore eu fugiat nulla\n                        pariatur.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tyGSuqHPa9",
          "_anchor": "content1-46",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content8",
          "_sourceTheme": "masterclassm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content8\" group=\"Article\" data-bg-video=\"{{bg.type == bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Numb\" name=\"showNumb\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"BG\" name=\"cardBg\" value=\"#51add0\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/masterclassm5/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"row justify-content-center\">\n                <div class=\"col-12\" mbr-if=\"showTitle || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mt-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\n                        data-app-selector=\".mbr-section-title\">\n                        <b>Who is the web design course for</b>\n                    </h3>\n                </div>\n                <div class=\"col-sm-6 col-lg-4 mt-5 text-white\">\n                    <div class=\"card-wrap\">\n                        <div class=\"content-wrap\">\n                            <div mbr-if=\"showNumb\">\n                                <div class=\"numb rounded-circle d-flex justify-content-center align-items-center mb-4\">\n                                    <p class=\"card-text mbr-fonts-style pe-1\" data-app-selector=\".card-text\"\n                                        mbr-theme-style=\"display-2\">\n                                        <b>1</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>For beginners</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Learn how to create high-quality visual interfaces, get the necessary skills to start in\n                                the profession and build a portfolio\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"col-sm-6 col-lg-4 mt-5 text-white\" mbr-if=\"cardsAmount>1\">\n                    <div class=\"card-wrap\">\n                        <div class=\"content-wrap\">\n                            <div mbr-if=\"showNumb\">\n                                <div class=\"numb rounded-circle d-flex justify-content-center align-items-center mb-4\">\n                                    <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\"\n                                        mbr-theme-style=\"display-2\">\n                                        <b>2</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>For designers</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                You will be able to develop your skills in creating visual interfaces and move to the\n                                profession of a UI designer\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"col-sm-6 col-lg-4 mt-5 text-white\" mbr-if=\"cardsAmount>2\">\n                    <div class=\"card-wrap\">\n                        <div class=\"content-wrap\">\n                            <div mbr-if=\"showNumb\">\n                                <div class=\"numb rounded-circle d-flex justify-content-center align-items-center mb-4\">\n                                    <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\"\n                                        mbr-theme-style=\"display-2\">\n                                        <b>3</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>Front-end developers</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Learn to create front-end solutions on your own and will be able to implement complete\n                                solutions for clients without intermediaries\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n\n        </div>\n\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".wrapper": {
              "@media (max-width: 991px)": {
                "padding": "0"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem 6rem"
              }
            },
            ".card-wrap": {
              "background": "@cardBg",
              "border-radius": "30px",
              "height": "100%",
              ".content-wrap": {
                "padding": "44px 40px",
                "@media (max-width: 991px)": {
                  "padding": "3rem 1rem"
                }
              }
            },
            ".numb": {
              "height": "100px",
              "width": "100px",
              "border": "2px solid"
            }
          },
          "_cid": "tyGSurhcOJ",
          "_anchor": "content8-47",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content6",
          "_sourceTheme": "masterclassm5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Content\" class=\"content6\"\n    data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\"\n            condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\"\n            condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Statistics\" name=\"showStatistics\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/masterclassm5/components/_images/background3.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\"\n            condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\n        bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapp\">\n\n            <div class=\"row justify-content-center\">\n                <div class=\"col-12\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-5 mt-5 mt-lg-0\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showTitle\">\n                        <b>Why Web Design?</b></h3>\n                </div>\n                <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\" mbr-if=\"showStatistics\">\n                    <div class=\"wrapper shadow mb-4 bg-body\">\n                        <div class=\"row\">\n                            <div class=\"col-4 col-md-5\">\n                                <h4 class=\"mbr-text mbr-fonts-style m-0\" mbr-theme-style=\"display-5\"><b>$</b>685</h4>\n                            </div>\n                            <div class=\"col-8 col-md-7 p-0\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-0\" mbr-theme-style=\"display-4\">Average salary for\n                                    an aspiring graphic designer\n                                </h5>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"wrapper shadow bg-body\">\n                        <div class=\"row\">\n                            <div class=\"col-4 col-md-5\">\n                                <h4 class=\"mbr-text mbr-fonts-style m-0\" mbr-theme-style=\"display-5\">&gt; 40%</h4>\n                            </div>\n                            <div class=\"col-8 col-md-7 p-0\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-0\" mbr-theme-style=\"display-4\">Vacancies on\n                                    freelance sites and on portal</h5>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-7 ps-lg-5 mt-3\" mbr-if=\"showText\">\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Create logos\n                        and corporate identity for brands.\n\n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Work remotely\n                        from anywhere in the world.\n                        Enjoy your job. After training, you will be able to work in an agency, freelance or on the staff\n                        of a large company. Which format to choose is up to you.\n                    </p>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Create a team and\n                        find clients on your own.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".wrapper": {
              "border-radius": "10px",
              "@media (max-width: 991px)": {
                "padding": "1rem"
              },
              "@media (min-width: 992px)": {
                "padding": "2rem"
              },
              "-webkit-box-shadow": "4px 4px 26px 1px rgba(34, 60, 80, 0.2)",
              "-moz-box-shadow": "4px 4px 26px 1px rgba(34, 60, 80, 0.2)",
              "box-shadow": "4px 4px 26px 1px rgba(34, 60, 80, 0.2)"
            },
            ".wrapp": {
              "@media (max-width: 991px)": {
                "padding": "0"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem 6rem"
              }
            }
          },
          "_cid": "tyGSurWiKc",
          "_anchor": "content6-48",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content03",
          "_sourceTheme": "dinerm4",
          "_customHTML": "<section class=\"content03 dinerm4_content03\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-restaurant-special-menu\">\n\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" >\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" >\n        <input type=\"range\" title=\"Group1 Items\" inline name=\"group1Items\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" >\n        <input type=\"range\" title=\"Group2 Items\" inline name=\"group2Items\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" >\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked >\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\" checked >\n        <input type=\"color\" title=\"Tags Color\" name=\"iconColor\" value=\"#89b758\" selected >\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@ADDONS_PATH@/dinerm4/components/_images/background1.jpg\" title=\"Image\" >\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected >\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\" title=\"Video\" >\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/dinerm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked >\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n            condition=\"overlay && bg.type !== 'color'\" >\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n            condition=\"overlay && bg.type !== 'color'\" >\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div class=\"container\">\n        <h4 class=\"mbr-section-subtitle mbr-semibold align-center mbr-fonts-style\" mbr-if=\"showsubTitle\"\n            mbr-theme-style=\"display-5\">Welcome</h4>\n        <h2 class=\"mbr-section-title align-center mbr-exbold mbr-fonts-style mbr-black\" mbr-theme-style=\"display-2\"\n            mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title,.ornament\">\n            Our Menu\n        </h2>\n\n        <div class=\"row\" mbr-class=\"{'pt-5':showTitle||showUnderline}\">\n            <div class=\"col-md-12 col-lg-6\">\n                <div class=\"menu-group\">\n                    <div class=\"row menu-row\" mbr-list mbr-list-grow=\"group1Items\" data-specials=\"{{specialsInGroup1}}\">\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/04.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    SUSHI\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Salmon Roll\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $18</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/03.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    THAI FOOD\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Spicy Fish Set<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $28</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/02.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    PIZZA\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Mozzarella Pizza\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $14</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/04.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    SUSHI\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Salmon Roll<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $18</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-md-12 col-lg-6\">\n                <div class=\"menu-group\">\n                    <div class=\"row menu-row\" mbr-list mbr-list-grow=\"group2Items\" data-specials=\"{{specialsInGroup2}}\">\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/03.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    THAI FOOD\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Spicy Fish Set<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $28</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/02.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    PIZZA\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Mozzarella Pizza<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $14</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/04.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    SUSHI\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Salmon Roll<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $18</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"col-md-12 menu-item\">\n                            <div class=\"mbr-figure\">\n                                <img src=\"@PROJECT_PATH@/assets/images/02.jpg\" alt=\"Mobirise\" >\n                            </div>\n                            <div class=\"wrapper\">\n                                <h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-tag\">\n                                    PIZZA\n                                </h5>\n                                <div class=\"menu-box\">\n                                    <p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n                                        data-app-selector=\".box-text\">\n                                        Mozzarella Pizza<br>\n                                    </p>\n                                    <div class=\"line\"></div>\n                                    <span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n                                        mbr-theme-style=\"display-7\"> $14</span>\n                                </div>\n                                <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                    data-app-selector=\".item-title\">\n                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ullamcorper eget lectus\n                                    porta euismod a libero.\n                                </h3>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".menu-item": {
              "padding": "0",
              "display": "flex",
              "margin-bottom": "1.5rem"
            },
            ".item-tag": {
              "background": "@iconColor",
              "width": "fit-content",
              "padding": "3px 16px 0px 16px",
              "border-radius": "10px",
              "margin-bottom": "12px"
            },
            ".mbr-iconfont": {
              "font-size": "2.5rem",
              "padding-right": "1rem",
              "color": "@iconColor"
            },
            ".mbr-figure": {
              "width": "150px",
              "height": "100%",
              "img": {
                "border-radius": "6px",
                "object-fit": "cover",
                "margin-right": "2rem",
                "width": "110px",
                "height": "110px"
              }
            },
            ".inline-wrap": {
              "width": "fit-content",
              "display": "inline-block"
            },
            ".group-title": {
              "margin": "0",
              "color": "#181818",
              "font-weight": "bold",
              "text-align": "left"
            },
            "@media (max-width: 991px)": {
              ".mbr-figure": {
                "width": "fit-content !important"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-figure": {
                "width": "100% !important"
              },
              ".menu-item": {
                "flex-direction": "column"
              },
              "img": {
                "margin": "auto !important",
                "margin-bottom": "0.5rem !important"
              },
              ".item-tag": {
                "margin": "auto",
                "margin-bottom": "1rem"
              }
            },
            ".icon-wrap": {
              "display": "flex",
              "margin-bottom": "1.5rem",
              "align-items": "center",
              "width": "fit-content"
            },
            ".special-label": {
              "color": "#fff"
            },
            ".menu-box": {
              "display": "flex",
              "align-items": "baseline",
              "margin-bottom": "0.5rem",
              "-webkit-justify-content": "space-between",
              "justify-content": "space-between",
              ".box-price": {
                "-webkit-flex-shrink": "0",
                "flex-shrink": "0"
              }
            },
            ".menu-row": {
              "margin": "0"
            },
            ".box-text": {
              "padding": "0",
              "margin": "0",
              "width": "fit-content",
              "color": "#000000"
            },
            ".line": {
              "display": "flex",
              "flex": "1 1 auto",
              "background-image": "radial-gradient(circle closest-side, #9a9a9a 99%, rgba(255, 255, 255, 0) 1%)",
              "background-size": "12px 2px",
              "background-position": "center",
              "margin": "0.2em 0.5em",
              "background-repeat": "repeat",
              "height": "2px"
            },
            ".group-title, .align-wrap": {
              "text-align": "left"
            },
            "SPAN": {
              "color": "#89b758"
            },
            ".item-title": {
              "color": "#808080"
            },
            "H4": {
              "color": "#89b758"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_cid": "tyGSusuMAS",
          "_anchor": "content03-49",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content04",
          "_sourceTheme": "dinerm4",
          "_customHTML": "<section class=\"content04 dinerm4_content04\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n\tmbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-restaurant-special-menu\">\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" >\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" >\n\t\t<input type=\"range\" title=\"Group1 Items\" inline name=\"group1Items\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" >\n\t\t<input type=\"range\" title=\"Group2 Items\" inline name=\"group2Items\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" >\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked >\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\" checked >\n\t\t<input type=\"color\" title=\"Tags Color\" name=\"iconColor\" value=\"#e7272d\" selected >\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@ADDONS_PATH@/dinerm4/components/_images/background1.jpg\" title=\"Image\" >\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\" selected >\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\" title=\"Video\" >\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/dinerm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked >\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n\t\t\tcondition=\"overlay && bg.type !== 'color'\" >\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n\t\tmbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<h4 class=\"mbr-section-subtitle mbr-semibold align-center mbr-fonts-style\" mbr-if=\"showsubTitle\"\n\t\t\tmbr-theme-style=\"display-5\">Menu</h4>\n\t\t<h2 class=\"mbr-section-title align-center mbr-exbold mbr-fonts-style mbr-black\" mbr-theme-style=\"display-2\"\n\t\t\tmbr-if=\"showTitle\" data-app-selector=\".mbr-section-title,.ornament\">\n\t\t\tChoose your dish\n\t\t</h2>\n\n\t\t<div class=\"row\" mbr-class=\"{'pt-5':showTitle||showUnderline}\">\n\t\t\t<div class=\"col-md-12 col-lg-6\">\n\t\t\t\t<div class=\"menu-group\">\n\t\t\t\t\t<div class=\"row menu-row\" mbr-list mbr-list-grow=\"group1Items\" data-specials=\"{{specialsInGroup1}}\">\n\t\t\t\t\t\t<div class=\"col-md-12 menu-item\">\n\t\t\t\t\t\t\t<div class=\"wrapper\">\n\t\t\t\t\t\t\t\t<h5 class=\"item-tag mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\t\tdata-app-selector=\".item-tag\">\n\t\t\t\t\t\t\t\t\tSUSHI\n\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t<div class=\"menu-box\">\n\t\t\t\t\t\t\t\t\t<p class=\"box-text mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\"\n\t\t\t\t\t\t\t\t\t\tdata-app-selector=\".box-text\">\n\t\t\t\t\t\t\t\t\t\tSalmon Roll\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t\t\t\t<span mbr-text class=\"mbr-fonts-style mbr-bold box-price mbr-black\"\n\t\t\t\t\t\t\t\t\t\tmbr-theme-style=\"display-7\"> $18</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\"\n\t\t\t\t\t\t\t\t\tdata