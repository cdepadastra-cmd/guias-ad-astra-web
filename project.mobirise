          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".container-fluid": {
              "max-width": "1500px"
            },
            ".icon1": {
              "font-size": "2.2rem"
            },
            ".team-card": {
              "margin-bottom": "2rem",
              "transition": "all 0.3s",
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            "@media (min-width: 1400px)": {
              ".col-lg-3": {
                "padding": "0 1.5rem"
              }
            },
            ".card-wrap": {
              "height": "100%",
              "margin-bottom": "2rem",
              "display": "flex",
              "flex-direction": "column",
              "&:hover": {
                "img": {
                  "transform": "scale(1.1)"
                }
              },
              "background": "@cardBg",
              "border-radius": "4px",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              ".image-wrap img": {
                "width": "100%",
                "transition": "all 0.3s",
                "height": "300px",
                "object-fit": "cover"
              },
              ".content-wrap": {
                "margin": "auto",
                "@media (min-width: 768px)": {
                  "padding": "2rem"
                },
                "@media (max-width: 767px)": {
                  "padding": "1rem"
                }
              }
            },
            ".content-wrap": {
              "height": "100%",
              "justify-content": "space-between",
              "display": "flex",
              "flex-direction": "column"
            },
            ".text-wrapper": {
              "display": "flex",
              "span": {
                "color": "@primaryColor",
                "padding-right": "1rem"
              }
            },
            ".mbr-main-subtitle": {
              "background": "@primaryColor",
              "width": "fit-content",
              "padding": "0.4rem 0.8rem",
              "position": "relative",
              "margin-bottom": "2rem",
              "&:before": {
                "content": "''",
                "position": "absolute",
                "left": "0",
                "bottom": "-18px",
                "border-left": "24px solid @primaryColor",
                "border-bottom": "18px solid transparent",
                "z-index": "2"
              },
              "@media (max-width: 767px)": {
                "margin": "auto",
                "margin-bottom": "2rem"
              }
            },
            ".social": {
              "display": "inline-flex",
              "align-items": "center",
              "margin-bottom": "0.5rem",
              "padding-left": "3rem",
              ".mbr-iconfont": {
                "padding-right": "0.6rem",
                "color": "@primaryColor"
              },
              "@media (max-width: 767px)": {
                "padding-left": "0rem"
              }
            },
            ".icons-menu": {
              "display": "flex",
              "@media (max-width: 767px)": {
                "justify-content": "center"
              }
            },
            ".image-wrap": {
              "clip-path": "polygon(100% 0, 100% 100%, 0% 94%, 0% 0%)"
            },
            ".iconfont-wrapper": {
              "font-size": "1.2rem",
              "padding": "0.4rem 0",
              "margin": "0 0.2rem",
              "display": "block",
              "position": "relative",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "bottom": "0",
                "left": "0",
                "transition": "all 0.3s",
                "width": "100%",
                "height": "0%",
                "background": "@primaryColor",
                "z-index": "0"
              },
              "&:hover": {
                "&:before": {
                  "height": "100%"
                }
              }
            },
            ".mbr-iconfont": {
              "position": "relative",
              "fomt-size": "1rem",
              "color": "@socialIconColor"
            },
            ".card-text, .mbr-section-btn, .social-row": {
              "color": "#353535"
            },
            ".mbr-role, .social-row": {
              "color": "#353535"
            },
            ".card-title, .social-row": {
              "color": "#272727"
            },
            ".mbr-section-title": {
              "color": "#272727"
            },
            ".card1-text": {
              "color": "#272727"
            },
            ".soc-link, .soc-wrapper": {
              "color": "#272727"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"team2\" group=\"Team\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <header>Main Card</header>\n        <input type=\"range\" inline title=\"Links\" name=\"links\" min=\"0\" max=\"3\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showsubTitle\" title=\"Subtitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\" checked>\n        <input type=\"color\" title=\"BG\" name=\"cardBg\" value=\"#ffffff\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"4\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#272727\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-6.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#e9f780\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-6.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        condition=\"overlay &amp;&amp; bg.type === 'video'\"&gt;\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" video-to-image-on-mobile=\"{{videoToImageOnMobile}}\">\n        <div class=\"row\">\n\n            <div class=\"col-sm-6 col-lg-3\">\n                <div class=\"content py-5\">\n                    <h3 class=\"mbr-main-subtitle mbr-fonts-style align-left\" mbr-if=\"showsubTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-main-subtitle\"><b>PACKS DE AVENTURA</b></h3>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>COMPAGINA ESTA ACTIVIDAD CON...</b></h4>\n                    <div class=\"text-wrapper\">\n                        <span mbr-icon class=\"mbr-iconfont icon1 align-center mobi-mbri-quote-left mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                        <p class=\"card1-text pb-3 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card1-text\">Si quieres hacer un pack de actividades cercanas a la anterior, te ofrecemos las siguientes posibilidades con descuento.<br><br><br></p>\n                    </div>\n\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 0\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-present-box\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\">La camiseta se dará de regalo en la bolsa del corredor</span>\n                        </div>\n                    </div>\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 1\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\"></span>\n\n                        </div>\n                    </div>\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 2\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\">facebook.com/yourLink</span>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6 col-lg-3 item features-image\">\n                <div class=\"card-wrap item-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/img-7-2000x1500.jpg\" alt=\"escalada en roca avila\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <div class=\"text\">\n                            <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                                <b>Escalada</b></h5>\n                            <h6 class=\"mbr-role mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">Camiseta amarillo fluor</h6>\n                            <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\">Bautismo de escalada en roca en Ávila.<br>Disfruta y siente la verticalidad de la escalada.</p>\n                        </div>\n                        <div class=\"links\">\n                            <div class=\"icons-menu\" mbr-if=\"showSocial\">\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 1\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 2\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 3\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"mbr-section-btn pt-2 card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-success\" href=\"barranquismo-avila.html#people02-f1\" data-app-placeholder=\"Type Text\">+30€</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6 item features-image  col-lg-3\">\n                <div class=\"card-wrap item-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/2016-0101-035552-1-2000x1500.jpg\" alt>\n                    </div>\n                    <div class=\"content-wrap\">\n                        <div class=\"text\">\n                            <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                                <b>Barranquismo</b></h5>\n                            <h6 class=\"mbr-role mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                Sudadera charcoal</h6>\n                            <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\">\n                                Las vías ferratas son escaladas en roca con la seguridad de un cable y peldaños para ayudar en la progresión.</p>\n                        </div>\n                        <div class=\"links\">\n                            <div class=\"icons-menu\" mbr-if=\"showSocial\">\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 1\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 2\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 3\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"mbr-section-btn pt-2 card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-success\" href=\"barranquismo-avila.html#people02-f1\" data-app-placeholder=\"Type Text\">+25€</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n        </div>\n    </div>\n</section>",
          "_anchor": "people02-i2",
          "_isUserblock": true,
          "_cid": "tK04xPfl3b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
