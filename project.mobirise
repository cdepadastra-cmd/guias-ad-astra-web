                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "left": "-4.4rem",
                  "bottom": "-10.5rem",
                  "display": "block",
                  "width": "410px",
                  "height": "410px",
                  "border": "30px solid @circle",
                  "border-radius": "50%",
                  "background-color": "transparent",
                  "z-index": "1",
                  "& when (@reverseContent)": {
                    "left": "auto",
                    "right": "-4.4rem"
                  },
                  "@media (max-width: 992px)": {
                    "display": "none"
