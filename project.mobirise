        {
          "_name": "content07",
          "_sourceTheme": "carm4",
          "_customHTML": "<section class=\"content07 carm4_content07\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\"\n    mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"7\"\n            condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Main Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Text Blocks Titles\" name=\"showTextBlocksTitles\" checked>\n        <input type=\"checkbox\" title=\"Text Blocks\" name=\"showTextBlocks\" checked>\n        <input type=\"color\" title=\"List bg color\" name=\"listBgColor\" value=\"#333333\">\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Icon\" name=\"showCounter\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"List Icon Color\" name=\"counterColor\" value=\"#ffffff\"\n            condition=\"showCounter&&showList\">\n        <input type=\"color\" title=\"Icon Bg Color\" name=\"counterBgColor\" value=\"#1352ff\"\n            condition=\"showCounter&&showList\">\n        <input type=\"checkbox\" title=\"Content reverse\" name=\"reverse\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/carm4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#000000\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\"\n            condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\n            condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-5\">\n                <div class=\"content-left-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-bold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-2\"\n                        mbr-if=\"showTitle\" data-app-selector=\".content-left-wrapper .mbr-section-title\">\n                        Trade-In Value\n                    </h1>\n                    <p class=\"subtitle mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\"\n                        data-app-selector=\".content-left-wrapper .subtitle\">Get the latest\n                        information on your vehicle’s trade-in value today.\n                    </p>\n                    <div class=\"text-wrap row mt-5\" mbr-if=\"showTextBlocks\">\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-2 textBlockTitle\"\n                                mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\">National Base\n                                Price\n                            </p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Donec id elit non mi\n                                porta gravida at eget metus.</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\"\n                                mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\">Optional\n                                Equipment\n                            </p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Donec id elit non mi\n                                porta gravida at eget metus.</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\"\n                                mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\">Color Adjustment\n                            </p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Donec id elit non mi\n                                porta gravida at eget metus.</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\"\n                                mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\">Mileage\n                                Adjustment\n                            </p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\"\n                                mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\"\n                                data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Donec id elit non mi\n                                porta gravida at eget metus.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-7 col-12 pl-lg-5\">\n                <div class=\"content-right-wrapper align-left\">\n                    <p class=\"mbr-text mbr-white mbr-bold mbr-white mbr-fonts-style px-3\" mbr-theme-style=\"display-5\"\n                        mbr-if=\"showListTitle\" data-app-selector=\".content-right-wrapper .mbr-text\">\n                        Trade-in value point</p>\n                    <div class=\"text-wrap row justify-content-center\" mbr-if=\"showTextBlocks\">\n                        <div class=\"col-sm-6 col-12\">\n                            <div class=\"mbr-list mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                data-app-selector=\".content-right-wrapper .text-wrap .mbr-list\" data-multiline\n                                mbr-article mbr-if=\"showList\">\n                                <ul class=\"list\" mbr-if=\"showList\">\n                                    <li>Tortor aliquam nulla</li>\n                                    <li>Mattis molestie a iaculis</li>\n                                    <li>Cursus in hac habitasse</li>\n                                    <li>Vulputate ut pharetra sit</li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div class=\"col-sm-6 col-12\">\n                            <div class=\"mbr-list mbr-fonts-style\" mbr-theme-style=\"display-4\"\n                                data-app-selector=\".content-right-wrapper .text-wrap .mbr-list\" data-multiline\n                                mbr-article mbr-if=\"showList\">\n                                <ul class=\"list\" mbr-if=\"showList\">\n                                    <li>Tortor aliquam nulla</li>\n                                    <li>Mattis molestie a iaculis</li>\n                                    <li>Cursus in hac habitasse</li>\n                                    <li>Vulputate ut pharetra sit</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverse)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-wrap": {
              "margin-top": "32px"
            },
            ".content-right-wrapper": {
              "background-color": "@listBgColor",
              "padding": "32px",
              ".mbr-list": {
                "color": "#ffffff",
                ".list": {
                  "list-style-type": "none",
                  "padding-left": "0",
                  "@media (max-width: 767px)": {
                    "text-align": "left"
                  },
                  "li": {
                    "line-height": "1.8",
                    "&:before": {
                      "& when (@showCounter)": {
                        "font-weight": "900",
                        "color": "@counterColor",
                        "display": "inline-block",
                        "font-size": "9px",
                        "content": "\"\\e97c\"",
                        "font-family": "\"Moririse2\" !important",
                        "text-align": "center",
                        "line-height": "1em",
                        "transition": "all 0.3s",
                        "margin-right": "10px",
                        "border-radius": "50%",
                        "padding": "5px",
                        "background-color": "@counterBgColor"
                      }
                    }
                  }
                }
              }
            }
          },
          "_cid": "tyGSupfoY5",
          "_anchor": "content07-44",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content7",
          "_sourceTheme": "masterclassm5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Content\" class=\"content7\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitleCard\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Info\" name=\"showInfo\" checked>\n        <select title=\"Amount\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"color\" title=\"Background\" name=\"cardsBg\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/masterclassm5/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"wrapper\">\n            <div class=\"mbr-section-head\" mbr-if=\"showTitle\">\n                <h3 mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                    <b>Calendario de actividades</b></h3>\n            </div>\n            <div class=\"row mt-4\">\n                <div class=\"card col-12\">\n                    <div class=\"card-wrapper mb-5\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b3 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">12 September\n                                </h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-4\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">ASCENSIÓN AL MOREZÓN</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style m-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"/\" data-app-placeholder=\"Type Text\">Dificultad: Media</a>\n                                    <a class=\"btn btn-primary\" href=\"/\" data-app-placeholder=\"Type Text\">4 horas</a>\n                                    <a class=\"btn btn-primary\" href=\"/\" data-app-placeholder=\"Type Text\">20€/p.</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount>1\">\n                    <div class=\"card-wrapper mb-5\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b1 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">Todos los sábado y domingos</h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-4\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">BARRANCO DE LOS PAPÚOS</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center\" mbr-if=\"showButtons\"><a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">Dificultad: Media</a>\n                                    <a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">6\n                                        horas</a>\n                                    <a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">55€/p.</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount>2\">\n                    <div class=\"card-wrapper mb-5\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b2 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">soon</h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-4\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Faculty\n                                web design</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-white text-center\" mbr-if=\"showButtons\">\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Available</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">6\n                                        lessons</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Online\n                                        learning</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount>3\">\n                    <div class=\"card-wrapper mb-5\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b1 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">every Friday\n                                </h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-4\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Faculty\n                                web design</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center\" mbr-if=\"showButtons\">\n                                    <a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">Available</a>\n                                    <a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">6\n                                        lessons</a>\n                                    <a class=\"btn btn-warning\" href=\"/\" data-app-placeholder=\"Type Text\">Online\n                                        learning</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount>4\">\n                    <div class=\"card-wrapper mb-5\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b2 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">soon</h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-3\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Faculty\n                                web design</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-white text-center\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Available</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">6\n                                        lessons</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Online\n                                        learning</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount>5\">\n                    <div class=\"card-wrapper\">\n                        <div mbr-if=\"showInfo\">\n                            <div class=\"info b2 rounded-circle text-center text-white  d-flex align-items-center\">\n                                <h5 class=\"mbr-text mbr-fonts-style m-auto p-2\" mbr-theme-style=\"display-4\">soon</h5>\n                            </div>\n                        </div>\n\n                        <div class=\"top-line mb-3\" mbr-if=\"showTitleCard\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Faculty\n                                web design</h4>\n                        </div>\n                        <div class=\"bottom-line row\">\n                            <div class=\"col-12 col-lg-5 mb-5 mb-lg-0\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                    Tools to help web designers create cool websites that help businesses\n                                </p>\n                            </div>\n                            <div class=\"col-12 col-lg-7\">\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-white text-center\" mbr-if=\"showButtons\">\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Available</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">6\n                                        lessons</a>\n                                    <a class=\"btn btn-secondary\" href=\"/\" data-app-placeholder=\"Type Text\">Online\n                                        learning</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".wrapper": {
              "@media (max-width: 991px)": {
                "padding": "0"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem 6rem"
              }
            },
            ".card-wrapper": {
              "background-color": "@cardsBg",
              "border-radius": "30px",
              "border": "1px solid",
              "background": "@cardsBg",
              "transition": "all 0.3s",
              "position": "relative",
              "padding": "44px 40px"
            },
            "@media (max-width: 991px)": {
