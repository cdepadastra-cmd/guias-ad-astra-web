        {
          "_name": "article02",
          "_sourceTheme": "workflowm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\r\n    mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\">\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\r\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\r\n            condition=\"fullScreen == false\">\r\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\"\r\n            condition=\"fullScreen == false\">\r\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\r\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\r\n        <header>Show/Hide</header>\r\n        <input type=\"range\" inline name=\"items\" title=\"Items\" min=\"0\" max=\"3\" step=\"1\" value=\"3\">\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/workflowm5/components/_images/background1.jpg\">\r\n            <input type=\"color\" title=\"Color\" value=\"#ffedec\" selected>\r\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/workflowm5/components/_images/background1.jpg\" name=\"fallBackImage\"\r\n            condition=\"bg.type === 'video'\">\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\r\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\"\r\n            condition=\"overlay && bg.type !== 'color'\">\r\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\"\r\n            condition=\"overlay && bg.type !== 'color'\">\r\n    </mbr-parameters>\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\"\r\n        bg-color=\"{{overlayColor}}\"></div>\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row justify-content-center\">\r\n            <div class=\"col-12 col-lg col-md-12\">\r\n                <div class=\"text-wrapper pb-3 align-left\">\r\n                    <h2 class=\"mbr-section-title align-left mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Optimize Workflow</b></h2>\r\n                    <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                        data-app-selector=\".mbr-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consectetur\r\n                        adipiscing elit. Vivamus urna lorem, facilisis ac dignissim nec, facilisis vitae leo. Fusce in\r\n                        sagittis risus,</p>\r\n                    <div class=\"item\" mbr-if=\"items > 0\">\r\n                        <h3 class=\"mbr-section-title align-left mbr-fonts-style mb-3\"\r\n                            data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\r\n                            <b>Lorem ipsum dolor sit amet,</b>\r\n                        </h3>\r\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                            data-app-selector=\".mbr-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consectetur\r\n                            adipiscing elit. Vivamus urna lorem, facilisis ac dignissim nec, facilisis vitae leo. Fusce\r\n                            in sagittis risus.<br></p>\r\n                    </div>\r\n                    <div class=\"item\" mbr-if=\"items > 1\">\r\n                        <h3 class=\"mbr-section-title align-left mbr-fonts-style mb-3\"\r\n                            data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\r\n                            <b>Donec lobortis consequat ullamcorper</b>\r\n                        </h3>\r\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                            data-app-selector=\".mbr-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consectetur\r\n                            adipiscing elit. Vivamus urna lorem, facilisis ac dignissim nec, facilisis vitae leo. Fusce\r\n                            in sagittis risus.</p>\r\n                    </div>\r\n                    <div class=\"item\" mbr-if=\"items > 2\">\r\n                        <h3 class=\"mbr-section-title align-left mbr-fonts-style mb-3\"\r\n                            data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\r\n                            <b>Mauris vel egestas urna</b>\r\n                        </h3>\r\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                            data-app-selector=\".mbr-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consectetur\r\n                            adipiscing elit. Vivamus urna lorem, facilisis ac dignissim nec, facilisis vitae leo. Fusce\r\n                            in sagittis risus.</p>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-3 align-left\"\r\n                        mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\"\r\n                            href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get Started Now</a></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}}\">\r\n                <div class=\"image-wrapper\">\r\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/features1.jpg\" alt=\"Mobirise Website Builder\">\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>",
