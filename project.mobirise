              "border-radius": "25px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "contain"
              }
            },
            ".img-row": {
              "position": "relative"
            },
            ".circle-blur": {
              "position": "absolute",
              "display": "block",
