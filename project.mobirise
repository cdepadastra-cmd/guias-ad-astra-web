              "margin-bottom": "2rem",
              "display": "flex",
              "flex-direction": "column",
              "&:hover": {
                "img": {
                  "transform": "scale(1.1)"
                }
              },
              "background": "@cardBg",
              "border-radius": "4px",
              "@media (max-width: 991px)": {
