                  "height": "100%"
                }
              }
            },
            ".mbr-iconfont": {
              "position": "relative",
              "fomt-size": "1rem",
              "color": "@socialIconColor"
            },
            ".card-text, .mbr-section-btn, .social-row": {
              "color": "#353535"
            },
            ".mbr-role, .social-row": {
