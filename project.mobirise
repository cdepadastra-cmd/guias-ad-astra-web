30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social fa-star-o fa\" style=\"color: rgb(158, 158, 158); fill: rgb(158, 158, 158);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;2 horas</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: No<br>Tirolina: No</span><br><span style=\"font-weight: normal;\">Puentes: Si</span><span style=\"font-weight: normal;\"><br></span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción: <span style=\"font-weight: 400;\">Ferrata de dificultad intermedia pero sin llegar a ser difícil</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"reservas-vias-ferratas.html\" data-app-placeholde