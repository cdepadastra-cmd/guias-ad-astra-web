                }
              }
            },
            ".content-wrap": {
              "height": "100%",
              "justify-content": "space-between",
              "display": "flex",
              "flex-direction": "column"
            },
            ".text-wrapper": {
              "display": "flex",
              "span": {
                "color": "@primaryColor",
                "padding-right": "1rem"
              }
            },
            ".mbr-main-subtitle": {
              "background": "@primaryColor",
              "width": "fit-content",
              "padding": "0.4rem 0.8rem",
              "position": "relative",
              "margin-bottom": "2rem",
              "&:before": {
                "content": "''",
                "position": "absolute",
                "left": "0",
                "bottom": "-18px",
                "border-left": "24px solid @primaryColor",
                "border-bottom": "18px solid transparent",
                "z-index": "2"
              },
              "@media (max-width: 767px)": {
