 style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;6 noches</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Distancia: 119km\n</span><div><span style=\"font-weight: 400;\">Etapas: 5\n</span></div><div><span style=\"font-weight: 400;\">Noches: 6</span></div></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Incluye:</h3><br><br></div><div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">- Alojamiento en Hoteles y Casas Rurales\n</span><div><span style=\"font-weight: 400;\">- Habitación con baño privado\n</span></div><div><span style=\"font-weight: 400;\">- Seguro de viaje\n</span></div><div><span style=\"font-weight: 400;\">- Pack de bienvenida con Credencial\n</span></div><div><span style=\"font-weight: 400;\">- Asistencia 24 horas\n</span></div><div><span style=\"font-weight: 400;\">- Itinerario completo de la ruta\n</span></div><div><span style=\"font-weight: 400;\">- Vehículo en caso de urgencia\n</span></div><div><span style=\"font-weight: 400;\">- Cancelación gratuita 15 días antes</span></div></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción:\n\t\t\t\t\t\t\t\t<span style=\"font-weight: normal;\">-</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"reservas-travesias.html\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"card p-3 col-12 col-md-6\" mbr-class=\"{'col-lg-4': cardsAmount == '3'|| cardsAmount =='5'|| cardsAmount== '6'}\" mbr-if=\"cardsAmount > 1\">\n\t\t\t\t<div class=\"card-wrapper\">\n\t\t\t\t\t<div class=\"card-img\">\n\t\t\t\t\t\t<div class=\"price-box\" mbr-if=\"showPrice\">\n\t\t\t\t\t\t\t<h5 class=\"price mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".price\">457€/pax.</h5>\n\t\t\t\t\t\t</div>\n                        <a href=\"senderismo-avila-gredos.html\" class=\"text-primary\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/2016-0101-043108-4-1014x761.jpg\" title alt>\n                            </a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"card-box\">\n\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\">Camino de Santiago Portugués</h4>\n\t\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-4\" data-app-selector=\".card-box > p, .mbr-section-btn\">Desde Tui</p>\n\n\t\t\t\t\t\t<div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n                                <h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Dificultad:</h3>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social fa-star fa\" style=\"color: rgb(30, 198, 182); fill: rgb(30, 198, 182);\"></div>\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;7 noches</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Distancia: 120km\n<