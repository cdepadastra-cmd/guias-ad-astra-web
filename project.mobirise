i class=\"nav-item dropdown\"><a class=\"nav-link link mbr-black dropdown-toggle text-white\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">OTROS</a><div class=\"dropdown-menu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"organizacion-eventos-deportivos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Organización de eventos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"comarca-natural-oeste-de-gredos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Comarca Natural Oeste de Gredos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"via-verde-ruta-de-la-plata.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Vía Verde Ruta de la Plata</a><div class=\"dropdown\"><a class=\"mbr-black dropdown-item text-white text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" data-toggle=\"dropdown-submenu\">Nuestros eventos</a><div class=\"dropdown-menu dropdown-submenu\"><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"gredos-limpio.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Gredos Limpio</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"https://www.ultratrailgredos.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">Ultra de Gredos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"https://www.desafiobttfuenterrico.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">Desafío BTT Fuenterrico</a></div></div><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Iniciativas de turismo rural</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Creación, mantenimiento de senderos</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"proximamente.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Servicio de Route Setting</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"boulder-las-tuerces.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Boulder en Las Tuerces, Palencia</a><a class=\"mbr-black dropdown-item text-white text-primary\" href=\"boulder-zona-centro-salamanca-caceres.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Boulder en la Zona Centro (Ávila, Cáceres y Salamanca)</a></div></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-white text-primary\" href=\"alquiler-material-montana.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ALQUILER MATERIAL</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-white text-primary\" href=\"blog.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">BLOG</a></li></ul>\n\n            </div>\n            <button class=\"navbar-toggler \" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
