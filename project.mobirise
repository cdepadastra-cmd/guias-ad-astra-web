          "_name": "form1",
          "_sourceTheme": "travelm4",
          "_customHTML": "<section class=\"form1 travelm4_form1 form\" group=\"Forms\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"3\">\n\t\t<input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"text\" checked=\"\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax=\"\">\n\t\t\t<input type=\"image\" value=\"../_images/background3.jpg\" title=\"Image\">\n\t\t\t<input type=\"color\" value=\"#ececec\" title=\"Color\" selected=\"\">\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=JPe2mwq96cw\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#656565\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t\n            \n             <div class=\"col-lg-6 col-md-8 col-sm-12 align-left card\">\n               \n              <h2 mbr-if=\"showTitle\" class=\"title2 mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".title2\">\n\t\t\t\t\tOTROS MÉTODOS DE CONTACTO</h2> <br> <b>Email:</b> guiasadastra@gmail.com<br><br><b>Teléfono:</b> +34 621 075 048<br><br><br>Enviándonos sus datos acepta nuestra Política de Privacidad<br>\n            \n            \n            \n            \n            </div>\n\n\t\t\t<div class=\"col-lg-6 col-md-8 col-sm-12 align-left card\">\n\t\t\t\t<h2 mbr-if=\"showTitle\" class=\"title2 mbr-fonts-style pb-1 mbr-bold\" mbr-theme-style=\"display-5\" data-app-selector=\".title2\">RESERVA SENDERISMO</h2>\n\t\t\t\t<h3 mbr-if=\"text\" class=\"mbr-section-subtitle mbr-fonts-style pb-4\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-subtitle\">Una vez rellenes este formulario nos pondremos en contacto contigo por correo electrónico o teléfono lo antes posible para confirmarte las fechas y las instrucciones de pago.<br><br>Enviándonos sus datos acepta nuestra Política de Privacidad</h3>\n\t\t\t\t<div mbr-form=\"\">\n<!--Formbuilder Form-->\n<form action=\"guiasadastra@gmail.com\" name=\"Guías Ad Astra Form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Gracias por tu mensaje. Responderemos con la mayor brevedad posible.</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">\n</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" class=\"form-control-label mbr-fonts-style\">Nombre y apellidos</label>\n<div class=\"form-row row\">\n<div class=\"col\">\n<input type=\"text\" name=\"Nombre\" placeholder=\"Nombre\" data-form-field=\"Nombre\" required=\"required\" class=\"form-control text-multiple\" value=\"\">\n</div>\n<div class=\"col\">\n<input type=\"text\" name=\"Apellidos\" placeholder=\"Apellidos\" data-form-field=\"Apellidos\" required=\"required\" class=\"form-control text-multiple\" value=\"\">\n</div>\n</div>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Email\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"Email\" class=\"form-control-label mbr-fonts-style\">Email</label>\n<input type=\"email\" name=\"Email\" placeholder=\"Email\" data-form-field=\"Email\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"Número de teléfono\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"Número de teléfono\" class=\"form-control-label mbr-fonts-style\">Número de teléfono</label>\n<input type=\"tel\" name=\"Número de teléfono\" placeholder=\"Número de teléfono\" data-form-field=\"Número de teléfono\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"Elige la zona de senderismo\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"Elige la zona de senderismo\" class=\"form-control-label mbr-fonts-style\">Elige la zona de senderismo</label>\n<select name=\"Elige la zona de senderismo\" data-form-field=\"Elige la zona de senderismo\" mbr-theme-style=\"display-7\" class=\"form-control form-select\" required=\"required\">\n<option value=\"Senderismo en Ávila\">Senderismo en Ávila</option>\n<option value=\"Senderismo en Salamanca\">Senderismo en Salamanca</option>\n<option value=\"Senderismo en León\">Senderismo en León</option>\n<option value=\"Senderismo en Palencia\">Senderismo en Palencia</option>\n</select>\n</div>\n<div data-for=\"Número de personas\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"Número de personas\" class=\"form-control-label mbr-fonts-style\">Número de personas</label>\n<input type=\"number\" name=\"Número de personas\" placeholder=\"¿Cuántas personas sois?\" max=\"100\" min=\"0\" step=\"1\" data-form-field=\"Número de personas\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"¿Qué día estás interesado/a?\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"¿Qué día estás interesado/a?\" class=\"form-control-label mbr-fonts-style\">¿Qué día estás interesado/a?</label>\n<input type=\"date\" name=\"¿Qué día estás interesado/a?\" data-form-field=\"¿Qué día estás interesado/a?\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"2023-08-01\">\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Sugerencias\">\n<label mbr-text=\"\" mbr-theme-style=\"display-7\" for=\"Sugerencias\" class=\"form-control-label mbr-fonts-style\">¿Algo más que debamos saber?</label>\n<textarea name=\"Sugerencias\" placeholder=\"Si tienes alguna preferencia o sugerencia este es tu espacio.\" data-form-field=\"Sugerencias\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col-md-12 input-group-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 btn btn-form btn-primary\">Enviar mensaje</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "u37JpYW292",
