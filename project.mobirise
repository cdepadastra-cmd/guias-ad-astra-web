            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".form-group": {
              "-webkit-flex-grow": "1",
              "flex-grow": "1",
              "max-width": "100%"
            },
            ".card": {
              "background-color": "white",
              "padding": "2rem"
            },
            ".input-group-btn": {
              "display": "block"
            },
            ".form-control": {
              "background": "none",
              "border-radius": "6px !important"
            },
            ".form-control-label": {
              "font-weight": "700"
            },
            ".mbr-section-subtitle": {
              "color": "#656565",
              "text-align": "left"
            },
            ".title2": {
              "color": "#656565"
            },
            ".form-title": {
              "color": "#656565"
