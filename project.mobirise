font mbr-iconfont-social mbri-star\" style=\"color: rgb(30, 198, 182)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<div mbr-icon class=\"px-1 pb-3 pr-2 mbr-iconfont mbr-iconfont-social mbri-star\" style=\"color: rgb(158, 158, 158)\"></div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Duración:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;2 horas</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                         <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Info:</h3>\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">&nbsp;<br><span style=\"font-weight: normal;\">Rápeles: 9<br>Rapel más largo: 20m.<br>Saltos: Si<br>Toboganes: Si</span><span style=\"font-weight: normal;\"><br></span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\">\n\t\t\t\t\t\t\t<div class=\"ico-line\">\n\t\t\t\t\t\t\t\t<h3 class=\"rev mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" data-app-selector=\".rev\">Descripción: <span style=\"font-weight: 400;\">El Barranco del Pozo Airón se desarrolla en una de las más famosas cascadas de todas las Arribes del Duero, justo cuando el arroyo desemboca en el Río Tormes.</span></h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n                        <div class=\"ico-line-wrap\" align=\"center\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href=\"reservas-barranquismo.html\" data-app-placeholder=\"Type Text\">Reservar</a></div>\n            \n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
