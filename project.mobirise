        {
          "_name": "people02",
          "_sourceTheme": "laborm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".container-fluid": {
              "max-width": "1500px"
            },
            ".icon1": {
              "font-size": "2.2rem"
            },
            ".team-card": {
              "margin-bottom": "2rem",
              "transition": "all 0.3s",
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            "@media (min-width: 1400px)": {
              ".col-lg-3": {
                "padding": "0 1.5rem"
              }
            },
            ".card-wrap": {
              "height": "100%",
              "margin-bottom": "2rem",
              "display": "flex",
              "flex-direction": "column",
              "&:hover": {
                "img": {
                  "transform": "scale(1.1)"
                }
              },
              "background": "@cardBg",
              "border-radius": "4px",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              ".image-wrap img": {
                "width": "100%",
                "transition": "all 0.3s",
                "height": "300px",
                "object-fit": "cover"
              },
              ".content-wrap": {
                "margin": "auto",
                "@media (min-width: 768px)": {
                  "padding": "2rem"
                },
                "@media (max-width: 767px)": {
                  "padding": "1rem"
                }
              }
            },
            ".content-wrap": {
              "height": "100%",
              "justify-content": "space-between",
              "display": "flex",
              "flex-direction": "column"
            },
            ".text-wrapper": {
              "display": "flex",
              "span": {
                "color": "@primaryColor",
                "padding-right": "1rem"
              }
            },
            ".mbr-main-subtitle": {
              "background": "@primaryColor",
              "width": "fit-content",
              "padding": "0.4rem 0.8rem",
              "position": "relative",
              "margin-bottom": "2rem",
              "&:before": {
                "content": "''",
                "position": "absolute",
                "left": "0",
                "bottom": "-18px",
                "border-left": "24px solid @primaryColor",
                "border-bottom": "18px solid transparent",
                "z-index": "2"
              },
              "@media (max-width: 767px)": {
                "margin": "auto",
                "margin-bottom": "2rem"
              }
            },
            ".social": {
              "display": "inline-flex",
              "align-items": "center",
              "margin-bottom": "0.5rem",
              "padding-left": "3rem",
              ".mbr-iconfont": {
                "padding-right": "0.6rem",
                "color": "@primaryColor"
              },
              "@media (max-width: 767px)": {
                "padding-left": "0rem"
              }
            },
            ".icons-menu": {
              "display": "flex",
              "@media (max-width: 767px)": {
                "justify-content": "center"
              }
            },
            ".image-wrap": {
              "clip-path": "polygon(100% 0, 100% 100%, 0% 94%, 0% 0%)"
            },
            ".iconfont-wrapper": {
              "font-size": "1.2rem",
              "padding": "0.4rem 0",
              "margin": "0 0.2rem",
              "display": "block",
              "position": "relative",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "bottom": "0",
                "left": "0",
                "transition": "all 0.3s",
                "width": "100%",
                "height": "0%",
                "background": "@primaryColor",
                "z-index": "0"
              },
              "&:hover": {
                "&:before": {
                  "height": "100%"
                }
              }
            },
            ".mbr-iconfont": {
              "position": "relative",
              "fomt-size": "1rem",
              "color": "@socialIconColor"
            },
            ".card-text, .mbr-section-btn, .social-row": {
              "color": "#353535"
            },
            ".mbr-role, .social-row": {
              "color": "#353535"
            },
            ".card-title, .social-row": {
              "color": "#272727"
            },
            ".mbr-section-title": {
              "color": "#272727"
            },
            ".card1-text": {
              "color": "#272727"
            },
            ".soc-link, .soc-wrapper": {
              "color": "#272727"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"team2\" group=\"Team\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <header>Main Card</header>\n        <input type=\"range\" inline title=\"Links\" name=\"links\" min=\"0\" max=\"3\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showsubTitle\" title=\"Subtitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\" checked>\n        <input type=\"color\" title=\"BG\" name=\"cardBg\" value=\"#ffffff\">\n        <header condition=\"showSocial\">Social</header>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"4\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#272727\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-6.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#e9f780\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-6.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        condition=\"overlay &amp;&amp; bg.type === 'video'\"&gt;\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" video-to-image-on-mobile=\"{{videoToImageOnMobile}}\">\n        <div class=\"row\">\n\n            <div class=\"col-sm-6 col-lg-3\">\n                <div class=\"content py-5\">\n                    <h3 class=\"mbr-main-subtitle mbr-fonts-style align-left\" mbr-if=\"showsubTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-main-subtitle\"><b>PACKS DE AVENTURA</b></h3>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>COMPAGINA ESTA ACTIVIDAD CON...</b></h4>\n                    <div class=\"text-wrapper\">\n                        <span mbr-icon class=\"mbr-iconfont icon1 align-center mobi-mbri-quote-left mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                        <p class=\"card1-text pb-3 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card1-text\">Si quieres hacer un pack de actividades cercanas a la anterior, te ofrecemos las siguientes posibilidades con descuento.<br><br><br></p>\n                    </div>\n\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 0\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-present-box\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\">La camiseta se dará de regalo en la bolsa del corredor</span>\n                        </div>\n                    </div>\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 1\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\"></span>\n\n                        </div>\n                    </div>\n                    <div class=\"soc-wrapper align-left\" mbr-if=\"links > 2\">\n                        <div class=\"social\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                            <span mbr-text class=\"soc-link mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".soc-link, .soc-wrapper\">facebook.com/yourLink</span>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6 col-lg-3 item features-image\">\n                <div class=\"card-wrap item-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/img-7-2000x1500.jpg\" alt=\"escalada en roca avila\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <div class=\"text\">\n                            <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                                <b>Escalada en roca</b></h5>\n                            <h6 class=\"mbr-role mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">Camiseta amarillo fluor</h6>\n                            <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\">Bautismo de escalada en roca en León.<br>Disfruta y siente la verticalidad de la escalada.</p>\n                        </div>\n                        <div class=\"links\">\n                            <div class=\"icons-menu\" mbr-if=\"showSocial\">\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 1\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 2\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 3\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"mbr-section-btn pt-2 card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-success\" href=\"barranquismo-avila.html#people02-f1\" data-app-placeholder=\"Type Text\">+20€</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-sm-6 item features-image  col-lg-3\">\n                <div class=\"card-wrap item-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/11450028-692x519.jpg\" alt=\"via ferrata avila\">\n                    </div>\n                    <div class=\"content-wrap\">\n                        <div class=\"text\">\n                            <h5 class=\"mbr-section-title card-title mbr-fonts-style align-left m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                                <b>Vía ferrata</b></h5>\n                            <h6 class=\"mbr-role mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                Sudadera charcoal</h6>\n                            <p class=\"card-text mbr-fonts-style align-left\" data-app-selector=\".card-text, .mbr-section-btn, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\">\n                                Las vías ferratas son escaladas en roca con la seguridad de un cable y peldaños para ayudar en la progresión.</p>\n                        </div>\n                        <div class=\"links\">\n                            <div class=\"icons-menu\" mbr-if=\"showSocial\">\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 1\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 2\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                                </a>\n                                <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"socialCount > 3\">\n                                    <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                                </a>\n                            </div>\n                            <div class=\"mbr-section-btn pt-2 card-btn align-left\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-if=\"showCardButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-success\" href=\"barranquismo-avila.html#people02-f1\" data-app-placeholder=\"Type Text\">+25€</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n        </div>\n    </div>\n</section>",
          "_anchor": "people02-i9",
          "_isUserblock": true,
          "_cid": "tK0aReWZss",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afooter1",
          "_sourceTheme": "expertm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container": {
              "width": "100%",
              "max-width": "1310px",
              "@media (max-width: 1199px)": {
                "max-width": "960px"
              },
              "@media (max-width: 991px)": {
                "max-width": "720px"
              },
              "@media (max-width: 767px)": {
                "max-width": "540px"
              },
              "@media (max-width: 575px)": {
                "max-width": "100%",
                ".row": {
                  "> [class*=\"col\"]": {
                    "padding-left": "20px",
                    "padding-right": "20px"
                  }
                }
              }
            },
            ".item-wrap": {
              "width": "100%"
            },
            ".navbar-brand": {
              "display": "flex",
              "flex-basis": "100%",
              "flex-wrap": "wrap",
              "word-break": "break-word !important",
              "word-wrap": "break-word !important",
              "min-height": "50px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "margin-bottom": "35px",
              "padding": "0",
              "transition": "all 0.4s",
              "z-index": "1",
              "white-space": "normal",
              ".navbar-logo": {
                "margin-right": "0.5rem",
                "img": {
                  "width": "auto"
                }
              },
              ".navbar-caption": {
                "line-height": "inherit !important",
                "word-break": "break-word !important",
                "word-wrap": "break-word !important",
                "&:hover": {
                  "text-decoration-line": "none !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none",
                "word-break": "break-word !important",
                "word-wrap": "break-word !important",
                "&:hover": {
                  "text-decoration-line": "none !important"
                }
              }
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-4px -12px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "4px 12px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                "&:before": {
                  "opacity": "1"
                }
              }
            },
            ".col-links": {
              "@media (max-width: 767px)": {
                "padding-top": "20px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#19a6fa",
              "margin-bottom": "20px",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              }
            },
            ".list": {
              "width": "100%",
              "list-style": "none",
              "padding-left": "0",
              "margin-bottom": "40px",
              "color": "#C4CFDE",
              "transition": "0.4s all",
              "@media (max-width: 575px)": {
                "text-align": "center !important"
              },
              "li": {
                "width": "100%",
                "color": "inherit !important",
                "margin-bottom": "8px",
                "transition": "0.4s all",
                "&:not(:first-child)": {
                  "margin-top": "10px"
                }
              },
              "a": {
                "position": "relative",
                "color": "inherit !important",
                "line-height": "inherit !important",
                "transition": "0.4s all",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "width": "0",
                  "height": "1px",
                  "background-color": "@primaryColor",
                  "transition": "0.4s all"
                },
                "&:hover": {
                  "color": "@primaryColor !important",
                  "line-height": "inherit !important",
                  "&:before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".col-copyright": {
              "padding-top": "80px",
              "@media (max-width: 767px)": {
                "padding-top": "40px"
              }
            },
            ".border-item": {
              "width": "100%",
              "height": "1px",
              "background-color": "@borderColor"
            },
            ".copyright": {
              "color": "#C4CFDE",
              "padding": "40px 0"
            }
          },
          "_customHTML": "<section class=\"footer1 expertm5\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footers\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Content Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"range\" name=\"listCount\" title=\"List Count\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#1e2024\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked condition=\"showCopyright\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#16181c\" condition=\"showBorder && showCopyright\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#212428\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-sm-6 col-lg-3\" mbr-if=\"showLogo || showBrand || showSocial\">\n                <div class=\"item-wrap\">\n                    <div class=\"navbar-brand\" mbr-if=\"showLogo || showBrand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-adastra-pequeo-186x249.png\" alt=\"Guías Ad Astra\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                        <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white text-primary\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Ad Astra<br>Montaña y Aventura<br></a></span>\n                    </div>\n                    <div class=\"social-list\" mbr-if=\"showSocial\">\n                        <div class=\"soc-item\" mbr-if=\"socialCount>0\">\n                            <a href=\"https://www.instagram.com/guias_adastra/?hl=af\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span></a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                            <a href=\"https://www.facebook.com/guiasadastra/?locale=es_ES\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span></a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                            <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                            <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                            <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                            <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        ACTIVIDADES</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Senderismo</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Ascensiones</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Barranquismo</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Vías ferratas</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Escalada</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Espeleología</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Rutas invernales</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Alquiler de material</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Cursos</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Organización de eventos</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\" mbr-if=\"listCount > 1\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        INFORMACIÓN</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><a href=\"calendario-actividades-gredos.html\" class=\"text-primary\">Calendario actividades</a></li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Sobre nosotros</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Dónde estamos</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Blog</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Condiciones generales</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\">Política de cookies</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-sm-6 col-lg-3 col-links\" mbr-if=\"listCount > 2\">\n                <div class=\"item-wrap\">\n                    <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        CONTACTO</h5>\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Teléfono:</b> 621 075 048</li>\n                        <li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Correo:</b> guiasadastra@gmail.com</li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\"><b>Dirección: </b></li><li class=\"mbr-text item-wrap\" data-app-selector=\".list\">- Fuentes de Béjar (Salamanca).<br>- Vallespinoso de Cervera (Palencia).<br>- Valladolid (Valladolid).</li>\n                    </ul>\n                </div>\n            </div>\n\n\n        </div>\n        <div class=\"row\" mbr-if=\"showCopyright\">\n            <div class=\"col-12 col-copyright\">\n                <div class=\"border-item\" mbr-if=\"showBorder\"></div>\n                <p class=\"mbr-text mb-0 mbr-fonts-style copyright align-center\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2023&nbsp;<a href=\"https://www.cordonesweb.es\" class=\"text-success\" target=\"_blank\">CordonesWeb</a> - Todos los derechos reservados.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "tJNHHoUrzL",
          "_anchor": "afooter1-dg",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
